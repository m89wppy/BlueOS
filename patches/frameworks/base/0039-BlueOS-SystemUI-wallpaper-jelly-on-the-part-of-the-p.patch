@@ -154,8 +154,33 @@ class BlueOSWallpaperWeather(
     private var sensorOn = false
     private val sensors by lazy { context.getSystemService(SensorManager::class.java) }
 
+    /** «Прокрутка обоев» off: the jelly works only on a still wallpaper ([BlueOSJelly.allowed]). */
+    @Volatile private var jellyStill = BlueOSJelly.allowed(cr)
+    /** What the system shows of this picture for the screen (picture px, may be wider: scrolling) — see [screenPart]. */
+    @Volatile private var screenCrop: Rect? = null
+    /** the launcher's wallpaper offset (0.5 while the wallpaper is still) */
+    @Volatile private var xOffset = .5f
+
     /** Areas on this picture, and the screen showing now wants them. Under [lock] or on [handler]. */
-    private fun jellyActive() = jellySim != null && jellyCfg.on && (if (locked) jellyCfg.lock else jellyCfg.home)
+    private fun jellyActive() = jellySim != null && jellyCfg.on && jellyStill &&
+        (if (locked) jellyCfg.lock else jellyCfg.home)
+
+    /** 0.9: the crop of the picture the system shows for this screen (ImageWallpaper, with the picture). */
+    fun setScreenCrop(crop: Rect?) { screenCrop = crop }
+
+    /** 0.9: the wallpaper's offset from the launcher (ImageWallpaper.onOffsetsChanged). */
+    fun setOffset(x: Float) { xOffset = x }
+
+    /**
+     * The part of the picture on the screen now, picture px; null = unknown (the whole picture's width is taken as
+     * the screen's, as in 0.9.0 — that put a finger 1.6× off on a wide picture).
+     */
+    private fun screenPart(): android.graphics.RectF? {
+        val crop = screenCrop ?: return null
+        @Suppress("DEPRECATION") context.display?.getRealSize(screenSize) ?: return null
+        if (screenSize.x <= 0 || screenSize.y <= 0) return null
+        return BlueOSJelly.visible(crop, screenSize.x, screenSize.y, xOffset)
+    }
 
     /** The areas (and their soft masks) for the picture now: again when the picture or the settings change. */
     private fun rebuildJelly() {
