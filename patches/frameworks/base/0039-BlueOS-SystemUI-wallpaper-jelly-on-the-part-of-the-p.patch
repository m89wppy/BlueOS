             synchronized(lock) {
-                jellySim = masks?.let { BlueOSJelly.Sim(areas, src.width.toFloat(), src.height.toFloat()) }
+                jellySim = masks?.let { BlueOSJelly.Sim(areas, src.width.toFloat(), src.height.toFloat(), unit) }
                 jellyRenderer.setMasks(masks)
             }
         }
+        Log.i(TAG, "jelly: pic=$jellyKey on=${jellyCfg.on} still=$jellyStill lock=${jellyCfg.lock} home=${jellyCfg.home} " +
+            "areas=${areas.size} picture=${src?.width}x${src?.height} screen=${screenPart()} ready=${jellySim != null}")
         updateSensor()
     }
 
