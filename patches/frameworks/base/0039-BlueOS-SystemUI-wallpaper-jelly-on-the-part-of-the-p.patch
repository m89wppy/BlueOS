+            } else {
+                @Suppress("DEPRECATION") context.display?.getRealSize(screenSize)
+                px = x * sim.w / screenSize.x.coerceAtLeast(1)
+                py = y * sim.h / screenSize.y.coerceAtLeast(1)
+            }
             when (action) {
                 android.view.MotionEvent.ACTION_DOWN -> !blocked && sim.down(px, py)
                 android.view.MotionEvent.ACTION_MOVE -> { sim.move(px, py); false }
@@ -293,8 +331,35 @@ class BlueOSWallpaperWeather(
             handler.post { update(reprocess = true) }
         }
         context.getSystemService(DisplayManager::class.java)?.registerDisplayListener(displayListener, handler)
-        unobserve += K.observe(context, listOf(BlueOSJelly.KEY)) {
-            handler.post { jellyCfg = BlueOSJelly.read(cr); rebuildJelly(); update(reprocess = false) }
+        unobserve += K.observe(context, listOf(BlueOSJelly.KEY, K.WALL_SCROLL)) {
+            handler.post {
+                jellyCfg = BlueOSJelly.read(cr)
+                jellyStill = BlueOSJelly.allowed(cr)
+                rebuildJelly()
+                update(reprocess = false)
+            }
+        }
+        // testing without shaking the phone (shell only — it holds DUMP):
+        // adb shell am broadcast -a org.blueos.debug.JELLY_POKE --ef vx 0 --ef vy 2500
+        val poke = object : android.content.BroadcastReceiver() {
+            override fun onReceive(c: Context, i: android.content.Intent) {
+                handler.post {
+                    val ok = synchronized(lock) {
+                        val s = jellySim?.takeIf { jellyActive() }
+                        s?.poke(i.getFloatExtra("vx", 0f), i.getFloatExtra("vy", 2500f))
+                        s != null
+                    }
+                    Log.i(TAG, "jelly poke: ${if (ok) "moving" else "nothing to move (off, no areas or the wallpaper scrolls)"}")
+                    updateRunning()
+                }
+            }
+        }
+        try {
+            context.registerReceiver(poke, android.content.IntentFilter(ACTION_POKE), android.Manifest.permission.DUMP,
+                handler, Context.RECEIVER_EXPORTED)
+            unobserve += { try { context.unregisterReceiver(poke) } catch (e: IllegalArgumentException) {} }
+        } catch (e: RuntimeException) {
+            Log.w(TAG, "jelly poke receiver", e)
         }
         // the lock screen's fingers: whether one is on the character / under the lobby is asked right away (main thread)
