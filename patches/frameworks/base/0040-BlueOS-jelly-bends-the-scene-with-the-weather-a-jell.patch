+    /**
+     * The home screen's picture part for the launcher ([BlueOSJelly.VIEW_KEY]): it decides on a finger's down
+     * whether the jelly takes the gesture. Only from the engine showing the home screen; written only on a change.
+     */
+    private fun publishHome() {
+        if (!visible || locked) return
+        val sim = synchronized(lock) { jellySim?.takeIf { jellyActive() } }
+        val v = if (sim == null) "" else {
+            val part = screenPart() ?: android.graphics.RectF(0f, 0f, sim.w, sim.h)
+            "$jellyKey|${sim.w}|${sim.h}|${part.left}|${part.top}|${part.right}|${part.bottom}"
+        }
+        if (v == published) return
+        published = v
+        try { android.provider.Settings.Secure.putString(cr, BlueOSJelly.VIEW_KEY, v) } catch (e: RuntimeException) { Log.w(TAG, "jelly view", e) }
+    }
+
+    /** Screen px -> picture px of [sim] (the part of the picture on the screen). Under [lock]. */
+    private fun toPic(x: Float, y: Float, sim: BlueOSJelly.Sim): FloatArray {
+        val part = screenPart()
+        return if (part != null) {
+            floatArrayOf(part.left + x / screenSize.x * part.width(), part.top + y / screenSize.y * part.height())
+        } else {
+            @Suppress("DEPRECATION") context.display?.getRealSize(screenSize)
+            floatArrayOf(x * sim.w / screenSize.x.coerceAtLeast(1), y * sim.h / screenSize.y.coerceAtLeast(1))
+        }
+    }
+
+    /** The lock screen asks on a finger's down whether it is on an area (main thread). */
+    private fun lockHit(x: Float, y: Float): Boolean = synchronized(lock) {
+        val sim = jellySim ?: return false
+        if (!visible || !locked || !jellyActive()) return false
+        val p = toPic(x, y, sim)
+        sim.hit(p[0], p[1])
+    }
 
