+    private var jellyNode: RenderNode? = null
+
+    /**
+     * The scene (picture + weather) drawn through the jelly while it moves, so the weather's haze moves with it
+     * (2026-11-13: drawn over the scene from the plain picture, the haze vanished in the moving areas). False =
+     * nothing moves (or no hardware canvas): draw the scene as is. Under [lock].
+     */
+    private fun jellyOnScene(canvas: Canvas): Boolean {
+        val s = jellySim ?: return false
+        if (!s.moving || !jellyActive() || !canvas.isHardwareAccelerated) return false
+        val w = canvas.width
+        val h = canvas.height
+        val fx = jellyRenderer.effect(s, w, h) ?: return false
+        val node = jellyNode ?: RenderNode("BlueOSJelly").also { jellyNode = it }
+        node.setPosition(0, 0, w, h)
+        val rc = node.beginRecording(w, h)
+        val drawn = try { drawScene(rc) } finally { node.endRecording() }
+        if (!drawn) return false
+        node.setRenderEffect(fx)
+        canvas.drawRenderNode(node)
+        return true
+    }
+
     /** The weather's current frame (no equalizer) as a hardware bitmap, or null; see [held]. */
