+    /** Lays the clock out as the scene sees the screen ([turn] degrees clockwise, as BlueOSLobbyView draws). */
+    private fun turnOverlay(turn: Float) {
+        val side = turn != 0f
+        // sideways: a box as big as the scene (the screen's height × width) in the middle, turned like it
+        val w = if (side) height else -1
+        val h = if (side) width else -1
+        if (turn == overlayTurn && overlay.layoutParams.width == w && overlay.layoutParams.height == h) return
+        overlayTurn = turn
+        overlay.layoutParams = (overlay.layoutParams as LayoutParams).also { it.width = w; it.height = h }
+        overlay.rotation = turn
+        // sideways the portrait status bar has slid away: the clock goes up to the scene's top edge
+        (clockBox.layoutParams as LayoutParams).let { lp ->
+            val top = ((if (side) 28 else 62) * dp).toInt()
+            if (lp.topMargin != top) { lp.topMargin = top; clockBox.layoutParams = lp }
+        }
+    }
+
     private fun restoreLockScreen() {
