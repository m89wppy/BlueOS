+    /** Areas on this picture, and the screen showing now wants them. Under [lock] or on [handler]. */
+    private fun jellyActive() = jellySim != null && jellyCfg.on && (if (locked) jellyCfg.lock else jellyCfg.home)
+
+    /** The areas (and their soft masks) for the picture now: again when the picture or the settings change. */
+    private fun rebuildJelly() {
+        val src = synchronized(lock) { sharp }
+        val areas = if (jellyCfg.on) jellyCfg.areas(jellyKey) else emptyList()
+        if (src == null || areas.isEmpty()) {
+            synchronized(lock) { jellySim = null }
+        } else {
+            val masks = try { BlueOSJelly.masks(areas, src.width, src.height) } catch (e: Throwable) { Log.w(TAG, "jelly masks", e); null }
+            synchronized(lock) {
+                jellySim = masks?.let { BlueOSJelly.Sim(areas, src.width.toFloat(), src.height.toFloat()) }
+                jellyRenderer.setMasks(masks)
+            }
+        }
+        updateSensor()
+    }
+
+    /** The phone's own acceleration — only while the jelly can show it (the wallpaper visible, the screen on). */
+    private fun updateSensor() {
+        val want = visible && screenOn && synchronized(lock) { jellyActive() && jellySim?.areas?.any { it.motion } == true }
+        if (want == sensorOn) return
+        sensorOn = want
+        val sm = sensors ?: return
+        if (want) {
+            sm.getDefaultSensor(Sensor.TYPE_LINEAR_ACCELERATION)?.let { sm.registerListener(accel, it, SensorManager.SENSOR_DELAY_GAME, handler) }
+        } else {
+            sm.unregisterListener(accel)
+            jellyAx = 0f; jellyAy = 0f
+        }
+    }
+
+    private val accel = object : SensorEventListener {
+        override fun onSensorChanged(e: SensorEvent) {
+            // the device's x right / y up → the screen's x right / y down (home and lock screen are upright)
+            var ax = e.values[0]
+            var ay = -e.values[1]
+            if (kotlin.math.hypot(ax, ay) < BlueOSJelly.DEADZONE) { ax = 0f; ay = 0f }
+            jellyAx = ax; jellyAy = ay
+            if ((ax != 0f || ay != 0f) && !running) updateRunning()
+        }
+        override fun onAccuracyChanged(s: Sensor?, accuracy: Int) {}
+    }
+
+    private val screenSize = android.graphics.Point()
+
+    /** A finger on the lock screen ([fromLock]) or the home screen (the launcher's command), screen px. */
+    private fun jellyTouch(action: Int, x: Float, y: Float, fromLock: Boolean, blocked: Boolean) {
+        val started = synchronized(lock) {
+            val sim = jellySim ?: return
+            if (!jellyActive() || fromLock != locked) { sim.up(); return }
+            @Suppress("DEPRECATION") context.display?.getRealSize(screenSize)
+            val px = x * sim.w / screenSize.x.coerceAtLeast(1)
+            val py = y * sim.h / screenSize.y.coerceAtLeast(1)
+            when (action) {
+                android.view.MotionEvent.ACTION_DOWN -> !blocked && sim.down(px, py)
+                android.view.MotionEvent.ACTION_MOVE -> { sim.move(px, py); false }
+                else -> { sim.up(); false }
+            }
+        }
+        if (started) updateRunning()
+    }
