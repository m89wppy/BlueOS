diff --git a/packages/SystemUI/src/com/android/systemui/shade/NotificationShadeWindowViewController.java b/packages/SystemUI/src/com/android/systemui/shade/NotificationShadeWindowViewController.java
index 214bb85fce1e..f15a205bd495 100644
--- a/packages/SystemUI/src/com/android/systemui/shade/NotificationShadeWindowViewController.java
+++ b/packages/SystemUI/src/com/android/systemui/shade/NotificationShadeWindowViewController.java
@@ -425,6 +425,13 @@ public class NotificationShadeWindowViewController implements Dumpable {
                     mTouchActive = false;
                     mDownEvent = null;
                 }
+                // BlueOS 0.9 «Лобби»: the lock screen's left edge and the lobby itself. Before the cancelled-touch
