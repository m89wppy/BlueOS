+    /** 0.9 «Чиби»: the students from the user's .glb files on the home screen (the launcher's BlueOSChibiLayer). */
+    private fun chibiPage(): List<Item> {
+        val shown = { on(K.CHIBI_ON) }
+        return listOf(
+            Item.Sw(K.CHIBI_ON, R.string.blueos_s_chibi_on, R.string.blueos_s_chibi_on_d),
+            Item.Value(R.string.blueos_s_chibi_who, { chibiCount() }) { pickChibis() },
+            Item.Btn(R.string.blueos_s_chibi_files, R.string.blueos_s_chibi_files_d, dep = { true }) { openAssets() },
+            Item.Header(R.string.blueos_s_h_chibi_life),
+            Item.Sw(K.CHIBI_WALK, R.string.blueos_s_chibi_walk, R.string.blueos_s_chibi_walk_d, dep = shown),
+            Item.Sw(K.CHIBI_SIT, R.string.blueos_s_chibi_sit, R.string.blueos_s_chibi_sit_d, dep = shown),
+            Item.Slider(K.CHIBI_SIT_DEPTH, R.string.blueos_s_chibi_depth, sub = true, max = 60, dep = { shown() && on(K.CHIBI_SIT) }) { v ->
+                getString(R.string.blueos_s_chibi_depth_d, v)
+            },
+            Item.Sw(K.CHIBI_PAT, R.string.blueos_s_chibi_pat, R.string.blueos_s_chibi_pat_d, dep = shown),
+            Item.Sw(K.CHIBI_ACTS, R.string.blueos_s_chibi_acts, R.string.blueos_s_chibi_acts_d, dep = shown),
+            Item.Info(R.string.blueos_s_chibi_touch, R.string.blueos_s_chibi_touch_d),
+            Item.Header(R.string.blueos_s_h_chibi_look),
+            Item.Slider(K.CHIBI_SIZE, R.string.blueos_s_chibi_size, min = 80, max = 170, dep = shown) { v ->
+                getString(when { v < 100 -> R.string.blueos_s_chibi_size_s; v < 135 -> R.string.blueos_s_chibi_size_m
+                                  v < 155 -> R.string.blueos_s_chibi_size_l; else -> R.string.blueos_s_chibi_size_xl })
+            },
+            Item.Choice(K.CHIBI_LIGHT, R.string.blueos_s_chibi_light, listOf(
+                R.string.blueos_s_chibi_light_game to 0, R.string.blueos_s_chibi_light_lit to 1), dep = shown),
+            Item.Choice(K.CHIBI_FPS, R.string.blueos_s_chibi_fps, listOf(
+                R.string.blueos_s_chibi_fps_60 to 60, R.string.blueos_s_chibi_fps_30 to 30, R.string.blueos_s_chibi_fps_15 to 15), dep = shown),
+        )
+    }
+
+    private fun hiddenChibis() = K.string(contentResolver, K.CHIBI_HIDDEN, "").split(';').filter { it.isNotBlank() }.toSet()
+
+    private fun chibiCount(): String {
+        val all = org.blueos.arona.BlueOSMedia.chibis()
+        if (all.isEmpty()) return getString(R.string.blueos_s_chibi_none)
+        val hidden = hiddenChibis()
+        return getString(R.string.blueos_s_chibi_count, all.count { it.name.dropLast(4) !in hidden }, all.size)
+    }
+
+    /** Which of the user's chibis are on the home screen (all by default). */
+    private fun pickChibis() {
+        val names = org.blueos.arona.BlueOSMedia.chibis().map { it.name.dropLast(4) }
+        if (names.isEmpty()) { openAssets(); return }
+        val hidden = hiddenChibis().toMutableSet()
+        val checked = BooleanArray(names.size) { names[it] !in hidden }
+        android.app.AlertDialog.Builder(this)
+            .setTitle(R.string.blueos_s_chibi_who)
+            .setMultiChoiceItems(names.toTypedArray(), checked) { _, i, c -> if (c) hidden -= names[i] else hidden += names[i] }
+            .setPositiveButton(android.R.string.ok) { _, _ -> put(K.CHIBI_HIDDEN, hidden.joinToString(";")) }
+            .setNegativeButton(android.R.string.cancel, null)
+            .show()
+    }
+
     private fun cityName() = K.string(contentResolver, K.WEATHER_CITY, "").substringBefore(';').ifEmpty { null }
 
     private class City(val name: String, val label: String, val lat: Double, val lon: Double)
