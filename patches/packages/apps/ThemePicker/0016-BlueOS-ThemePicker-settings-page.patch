+<?xml version="1.0" encoding="utf-8"?>
+<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
+    <string name="blueos_s_entry_chibi">Чиби</string>
+    <string name="blueos_s_entry_chibi_desc">Маленькие ученицы на рабочем столе: ходят по виджетам, сидят на них и отвечают на касания</string>
+    <string name="blueos_s_page_chibi">Чиби</string>
+    <string name="blueos_s_chibi_on">Чиби на рабочем столе</string>
+    <string name="blueos_s_chibi_on_d">Ученицы из твоих файлов персонажа живут на рабочем столе — поверх обоев и виджетов</string>
+    <string name="blueos_s_chibi_who">Кто на экране</string>
+    <string name="blueos_s_chibi_count"><xliff:g id="shown" example="2">%1$d</xliff:g> из <xliff:g id="all" example="3">%2$d</xliff:g></string>
+    <string name="blueos_s_chibi_none">Пока никого не добавлено</string>
+    <string name="blueos_s_chibi_files">Файлы персонажа</string>
+    <string name="blueos_s_chibi_files_d">3D-модели учениц (.glb) добавляются вместе с остальными файлами — одной папкой или одним архивом</string>
+    <string name="blueos_s_h_chibi_life">Что они делают</string>
+    <string name="blueos_s_chibi_walk">Гуляют</string>
+    <string name="blueos_s_chibi_walk_d">Иногда идут по верхнему краю виджета или перепрыгивают на другой виджет. Если выключить, стоят там, куда их поставили</string>
+    <string name="blueos_s_chibi_sit">Сидят на краю виджета</string>
+    <string name="blueos_s_chibi_sit_d">Иногда ученица садится на верхний край виджета и болтает ногами</string>
+    <string name="blueos_s_chibi_depth">Как низко садится</string>
+    <string name="blueos_s_chibi_depth_d">Опускается на <xliff:g id="pct" example="30">%d</xliff:g>%% своего роста — край виджета должен прийтись на сиденье</string>
+    <string name="blueos_s_chibi_pat">Можно гладить</string>
+    <string name="blueos_s_chibi_pat_d">Проведи пальцем по голове туда-сюда: она наклоняет голову под руку и радуется</string>
+    <string name="blueos_s_chibi_acts">Занятия, как в кафе</string>
+    <string name="blueos_s_chibi_acts_d">Иногда садится за десерт, клавиатуру или учёбу — если такие анимации есть в её модели</string>
+    <string name="blueos_s_chibi_touch">Касания</string>
+    <string name="blueos_s_chibi_touch_d">Нажатие — она падает и потом встаёт. Удерживай — возьмёшь в руки, отпустишь — упадёт на ближайший виджет под ней. Подарок из виджета «Подарки» — реагирует, как в кафе. Свайпы мимо неё листают экраны как обычно</string>
+    <string name="blueos_s_h_chibi_look">Вид</string>
+    <string name="blueos_s_chibi_size">Размер</string>
+    <string name="blueos_s_chibi_size_s">Маленькие</string>
+    <string name="blueos_s_chibi_size_m">Средние — чуть меньше одной ячейки виджета</string>
+    <string name="blueos_s_chibi_size_l">Крупные</string>
+    <string name="blueos_s_chibi_size_xl">Очень крупные</string>
+    <string name="blueos_s_chibi_light">Свет</string>
+    <string name="blueos_s_chibi_light_game">Как в игре — ровные цвета без бликов</string>
+    <string name="blueos_s_chibi_light_lit">Со светом и тенью</string>
+    <string name="blueos_s_chibi_fps">Плавность, когда их не трогают</string>
+    <string name="blueos_s_chibi_fps_60">Плавно — тратит больше батареи</string>
+    <string name="blueos_s_chibi_fps_30">Обычно</string>
+    <string name="blueos_s_chibi_fps_15">Экономно — чуть дёргано</string>
+</resources>
diff --git a/res/values/blueos_09_strings.xml b/res/values/blueos_09_strings.xml
