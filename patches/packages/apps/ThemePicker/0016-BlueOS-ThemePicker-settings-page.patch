@@ -0,0 +1,40 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- BlueOS 0.9: «Чиби» — 3D students from the user's own .glb files on the home screen -->
+<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
+    <string name="blueos_s_entry_chibi">Chibis</string>
+    <string name="blueos_s_entry_chibi_desc">Little students on your home screen: they walk on the widgets, sit on them and react when you touch them</string>
+    <string name="blueos_s_page_chibi">Chibis</string>
+    <string name="blueos_s_chibi_on">Chibis on the home screen</string>
+    <string name="blueos_s_chibi_on_d">The students from your character files live on the home screen, over the wallpaper and the widgets</string>
+    <string name="blueos_s_chibi_who">Who is on the screen</string>
+    <string name="blueos_s_chibi_count"><xliff:g id="shown" example="2">%1$d</xliff:g> of <xliff:g id="all" example="3">%2$d</xliff:g></string>
+    <string name="blueos_s_chibi_none">None added yet</string>
+    <string name="blueos_s_chibi_files">Character files</string>
+    <string name="blueos_s_chibi_files_d">Add the students\' 3D models (.glb) together with the other files — one folder or one archive</string>
+    <string name="blueos_s_h_chibi_life">What they do</string>
+    <string name="blueos_s_chibi_walk">Walk around</string>
+    <string name="blueos_s_chibi_walk_d">Now and then they walk along a widget\'s top edge or hop to another widget. Off: they stay where you put them</string>
+    <string name="blueos_s_chibi_sit">Sit on a widget\'s edge</string>
+    <string name="blueos_s_chibi_sit_d">Now and then a student sits down on a widget\'s top edge and swings her legs</string>
+    <string name="blueos_s_chibi_depth">How low she sits</string>
+    <string name="blueos_s_chibi_depth_d">Lowered by <xliff:g id="pct" example="30">%d</xliff:g>%% of her height — the edge should be her seat</string>
+    <string name="blueos_s_chibi_pat">Patting</string>
+    <string name="blueos_s_chibi_pat_d">Move a finger left and right over her head: she leans her head into your hand and is happy</string>
+    <string name="blueos_s_chibi_acts">Café activities</string>
+    <string name="blueos_s_chibi_acts_d">Now and then she sits down to a dessert, a keyboard or her studies — if her model has these animations</string>
+    <string name="blueos_s_chibi_touch">Touching her</string>
+    <string name="blueos_s_chibi_touch_d">A tap: she falls down and gets up again. Hold her: you pick her up, let go and she drops onto the nearest widget below. A gift from the Gifts widget: she reacts like in the café. Swipes past her still turn the pages</string>
+    <string name="blueos_s_h_chibi_look">Look</string>
+    <string name="blueos_s_chibi_size">Size</string>
+    <string name="blueos_s_chibi_size_s">Small</string>
+    <string name="blueos_s_chibi_size_m">Medium — a bit smaller than one widget cell</string>
+    <string name="blueos_s_chibi_size_l">Large</string>
+    <string name="blueos_s_chibi_size_xl">Very large</string>
+    <string name="blueos_s_chibi_light">Light</string>
+    <string name="blueos_s_chibi_light_game">Like in the game — flat colours, no shine</string>
+    <string name="blueos_s_chibi_light_lit">With light and shade</string>
+    <string name="blueos_s_chibi_fps">Smoothness when nobody touches them</string>
+    <string name="blueos_s_chibi_fps_60">Smooth — uses more battery</string>
+    <string name="blueos_s_chibi_fps_30">Normal</string>
+    <string name="blueos_s_chibi_fps_15">Battery saving — a little jerky</string>
+</resources>
