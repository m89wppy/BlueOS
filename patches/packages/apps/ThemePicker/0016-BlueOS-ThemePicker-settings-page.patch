                 CLOCK -> R.string.blueos_s_page_clock; MOTION -> R.string.blueos_s_page_motion
-                COLORS -> R.string.blueos_s_page_colors
+                COLORS -> R.string.blueos_s_page_colors; CHIBI -> R.string.blueos_s_page_chibi
                 else -> R.string.blueos_s_page_arona
             })
             setTextSize(TypedValue.COMPLEX_UNIT_SP, 30f)
@@ -638,7 +691,7 @@ class BlueOSSettingsActivity : Activity() {
