diff --git a/res/values-ru/blueos_09_strings.xml b/res/values-ru/blueos_09_strings.xml
index ef4051ac..df110c3b 100644
--- a/res/values-ru/blueos_09_strings.xml
+++ b/res/values-ru/blueos_09_strings.xml
@@ -159,4 +159,7 @@
     <string name="blueos_s_h_jelly_more">Ещё</string>
     <string name="blueos_s_jelly_info">Батарея</string>
     <string name="blueos_s_jelly_info_d">Обои перерисовываются, только пока что-то дрожит. На экране «Всегда включён» не работает. Новые обои начинаются без областей: они привязаны к картинке</string>
+    <!-- 0.9 «Прокрутка обоев» -->
+    <string name="blueos_s_wall_scroll">Прокрутка обоев</string>
+    <string name="blueos_s_wall_scroll_d">Обои сдвигаются вслед за страницами рабочего стола, как в обычном Android. Выключено — обои стоят на месте. Желе на обоях работает, только когда прокрутка выключена</string>
 </resources>
diff --git a/res/values/blueos_09_strings.xml b/res/values/blueos_09_strings.xml
index b741d069..247d0ef4 100644
