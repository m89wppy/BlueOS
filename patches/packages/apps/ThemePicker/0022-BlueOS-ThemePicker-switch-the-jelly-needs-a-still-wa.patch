@@ -160,4 +160,7 @@
     <string name="blueos_s_h_jelly_more">More</string>
     <string name="blueos_s_jelly_info">Battery</string>
     <string name="blueos_s_jelly_info_d">The wallpaper is redrawn only while something wobbles. It doesn\'t work on the always-on display. A new wallpaper starts without areas: they belong to the picture</string>
+    <!-- 0.9 «Прокрутка обоев» -->
+    <string name="blueos_s_wall_scroll">Wallpaper scrolling</string>
+    <string name="blueos_s_wall_scroll_d">The wallpaper moves along with the home screen pages, as in stock Android. Off: the wallpaper stays still. Jelly wallpaper works only while scrolling is off</string>
 </resources>
diff --git a/src/com/android/customization/blueos/BlueOSJellyEditorView.kt b/src/com/android/customization/blueos/BlueOSJellyEditorView.kt
index 836c30c1..84b268d9 100644
--- a/src/com/android/customization/blueos/BlueOSJellyEditorView.kt
+++ b/src/com/android/customization/blueos/BlueOSJellyEditorView.kt
@@ -65,6 +65,9 @@ class BlueOSJellyEditorView(context: Context) : View(context), Choreographer.Fra
 
     private val dp = resources.displayMetrics.density
     private var pic: Bitmap? = null
+    /** 0.9: the part of the picture the screen shows (fractions of the picture; the rest is dimmed), null = unknown */
+    private var screenPart: RectF? = null
+    private val screenRect = RectF()
     private var message: String? = null
     private var sim: BlueOSJelly.Sim? = null
     private val renderer by lazy { BlueOSJelly.Renderer() }
@@ -90,8 +93,26 @@ class BlueOSJellyEditorView(context: Context) : View(context), Choreographer.Fra
                 val k = min(1f, 1080f / it.width)
                 if (k < 1f) Bitmap.createScaledBitmap(it, (it.width * k).toInt(), (it.height * k).toInt(), true) else it
             }
+            // what the screen shows of it with the wallpaper still (the offset in the middle): a wide picture is cut
+            val part = b?.let { full ->
+                try {
+                    val bounds = context.getSystemService(android.view.WindowManager::class.java)
+                        .maximumWindowMetrics.bounds
+                    val size = listOf(android.graphics.Point(bounds.width(), bounds.height()))
+                    // a picture on both screens is the home one: the lock screen has no crops of its own then
+                    val crops = wm.getBitmapCrops(size, which, false).ifEmpty {
+                        wm.getBitmapCrops(size, WallpaperManager.FLAG_SYSTEM, false)
+                    }
+                    crops.firstOrNull()?.let { crop ->
+                        val v = BlueOSJelly.visible(crop, bounds.width(), bounds.height(), .5f)
+                        RectF(v.left / full.width, v.top / full.height, v.right / full.width, v.bottom / full.height)
+                            .takeIf { it.left >= -.01f && it.right <= 1.01f && it.bottom <= 1.01f }
+                    }
+                } catch (e: RuntimeException) { null }
+            }
             main.post {
                 pic = small
+                screenPart = part
                 message = if (small == null) liveText else null
                 requestLayout()
                 rebuild()
@@ -135,6 +156,15 @@ class BlueOSJellyEditorView(context: Context) : View(context), Choreographer.Fra
         canvas.drawBitmap(p, null, dst, picPaint)
         val s = sim
         if (s != null && s.moving && !edit) renderer.draw(canvas, p, dst, s)
+        screenPart?.let { f ->
+            // outside the screen's part: dimmed — areas there never show
+            screenRect.set(dst.left + f.left * dst.width(), dst.top + f.top * dst.height(),
+                dst.left + f.right * dst.width(), dst.top + f.bottom * dst.height())
+            canvas.save()
+            canvas.clipOutRect(screenRect)
+            canvas.drawColor(Color.argb(140, 0, 0, 0))
+            canvas.restore()
+        }
         if (!edit) return
         areas.forEachIndexed { i, a ->
             val path = BlueOSJelly.path(a, p.width.toFloat(), p.height.toFloat())
