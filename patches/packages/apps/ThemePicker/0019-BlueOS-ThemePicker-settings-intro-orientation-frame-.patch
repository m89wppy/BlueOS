+    /** 0.9 «Лобби»: a memorial lobby from the user's files, one swipe right of the lock screen (SystemUI). */
+    private fun lobbyPage(): List<Item> {
+        val shown = { on(K.LOBBY_ON) }
+        val any = { org.blueos.arona.BlueOSLobbies.list().isNotEmpty() }
+        return listOf(
+            Item.Sw(K.LOBBY_ON, R.string.blueos_s_lobby_on, R.string.blueos_s_lobby_on_d),
+            Item.Value(R.string.blueos_s_lobby_which, {
+                org.blueos.arona.BlueOSLobbies.chosen(this)?.title ?: getString(R.string.blueos_s_lobby_none)
+            }) { pickLobby() },
+            Item.Btn(R.string.blueos_s_lobby_preview, R.string.blueos_s_lobby_preview_d, dep = any) { previewLobby() },
+            Item.Btn(R.string.blueos_s_lobby_files, R.string.blueos_s_lobby_files_d, dep = { true }) { openAssets() },
+            Item.Choice(K.LOBBY_INTRO, R.string.blueos_s_lobby_intro, listOf(
+                R.string.blueos_s_lobby_intro_always to 0, R.string.blueos_s_lobby_intro_hour to 1,
+                R.string.blueos_s_lobby_intro_never to 2), dep = shown),
+            Item.Header(R.string.blueos_s_h_lobby_over),
+            Item.Choice(K.LOBBY_CLOCK, R.string.blueos_s_lobby_clock, listOf(
+                R.string.blueos_s_lobby_clock_none to 0, R.string.blueos_s_lobby_clock_time to 1,
+                R.string.blueos_s_lobby_clock_date to 2), dep = shown),
+            Item.Sw(K.LOBBY_FP, R.string.blueos_s_lobby_fp, R.string.blueos_s_lobby_fp_d, dep = shown),
+            Item.Sw(K.LOBBY_AUTOHIDE, R.string.blueos_s_lobby_autohide, R.string.blueos_s_lobby_autohide_d, dep = shown),
+            Item.Header(R.string.blueos_s_h_lobby_frame),
+            Item.Choice(K.LOBBY_ORIENT, R.string.blueos_s_lobby_orient, listOf(
+                R.string.blueos_s_lobby_orient_land to 0, R.string.blueos_s_lobby_orient_auto to 1,
+                R.string.blueos_s_lobby_orient_port to 2), dep = shown),
+            Item.Slider(K.LOBBY_ZOOM, R.string.blueos_s_lobby_zoom, min = 100, max = 180, dep = shown) { v ->
+                getString(R.string.blueos_s_lobby_zoom_d, v)
+            },
+            Item.Slider(K.LOBBY_PAN, R.string.blueos_s_lobby_pan, min = -100, max = 100, dep = shown) { v ->
+                getString(when { v < -10 -> R.string.blueos_s_lobby_pan_left; v > 10 -> R.string.blueos_s_lobby_pan_right
+                                 else -> R.string.blueos_s_lobby_pan_mid })
+            },
+            Item.Sw(K.LOBBY_TILT, R.string.blueos_s_lobby_tilt, R.string.blueos_s_lobby_tilt_d, dep = shown),
+            Item.Header(R.string.blueos_s_h_lobby_sound),
+            Item.Choice(K.LOBBY_SOUND, R.string.blueos_s_lobby_sound, listOf(
+                R.string.blueos_s_lobby_sound_off to 0, R.string.blueos_s_lobby_sound_voice to 1,
+                R.string.blueos_s_lobby_sound_music to 2), dep = shown),
+            Item.Info(R.string.blueos_s_lobby_sound_info, R.string.blueos_s_lobby_sound_info_d),
+            Item.Header(R.string.blueos_s_h_lobby_more),
+            Item.Info(R.string.blueos_s_lobby_gestures, R.string.blueos_s_lobby_gestures_d),
+            Item.Choice(K.LOBBY_FPS, R.string.blueos_s_lobby_fps, listOf(
+                R.string.blueos_s_lobby_fps_60 to 60, R.string.blueos_s_lobby_fps_30 to 30), dep = shown),
+        )
+    }
+
+    private fun pickLobby() {
+        val all = org.blueos.arona.BlueOSLobbies.list()
+        if (all.isEmpty()) { openAssets(); return }
+        val cur = org.blueos.arona.BlueOSLobbies.chosen(this)?.name
+        AlertDialog.Builder(this)
+            .setTitle(R.string.blueos_s_lobby_which)
+            .setSingleChoiceItems(all.map { it.title }.toTypedArray(), all.indexOfFirst { it.name == cur }) { d, which ->
+                put(K.LOBBY, all[which].name); d.dismiss()
+            }
+            .setNegativeButton(android.R.string.cancel, null)
+            .show()
+    }
+
+    /** The chosen lobby full screen, as on the lock screen (also how its speed is measured: BlueOSLobby debug log). */
+    private fun previewLobby() {
+        val lobby = org.blueos.arona.BlueOSLobbies.chosen(this) ?: return
+        val view = org.blueos.arona.BlueOSLobbyView(this)
+        val dialog = android.app.Dialog(this, android.R.style.Theme_DeviceDefault_NoActionBar_Fullscreen)
+        dialog.setContentView(view)
+        dialog.window?.let { w ->
+            w.setDecorFitsSystemWindows(false)
+            w.attributes = w.attributes.apply {
+                layoutInDisplayCutoutMode = android.view.WindowManager.LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_ALWAYS
+            }
+            w.statusBarColor = android.graphics.Color.TRANSPARENT
+            w.navigationBarColor = android.graphics.Color.TRANSPARENT
+        }
+        dialog.setOnDismissListener { org.blueos.arona.BlueOSLobbies.release() }
+        view.show(lobby)
+        dialog.show()
+    }
+
     private fun shownChibis() = org.blueos.arona.BlueOSMedia.chibisShown(Settings.Secure.getString(contentResolver, K.CHIBI_SHOWN))
         .map { it.name.dropLast(4) }
 
