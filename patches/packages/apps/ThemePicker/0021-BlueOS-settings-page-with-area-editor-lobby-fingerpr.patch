+
+package com.android.customization.blueos
+
+import android.app.WallpaperManager
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.DashPathEffect
+import android.graphics.Matrix
+import android.graphics.Paint
+import android.graphics.Path
+import android.graphics.Rect
+import android.graphics.RectF
+import android.hardware.Sensor
+import android.hardware.SensorEvent
+import android.hardware.SensorEventListener
+import android.hardware.SensorManager
+import android.os.Handler
+import android.os.Looper
+import android.view.Choreographer
+import android.view.MotionEvent
+import android.view.View
+import kotlin.math.atan2
+import kotlin.math.cos
+import kotlin.math.hypot
+import kotlin.math.max
+import kotlin.math.min
+import kotlin.math.sin
+import org.blueos.arona.BlueOSJelly
+
+/**
+ * BlueOS 0.9 «Желе на обоях»: the wallpaper with its areas (approved mockup mockups/blueos-0.9-wiggle.html). Play
+ * mode: it wiggles exactly like the wallpaper will (the same [BlueOSJelly] springs and shader), shake the phone or
+ * pull an area. Edit mode: drag an area, its corner handle = size, the dot above = turn; «Своя» form = draw around
+ * something with the finger. [areas] are the page's list (normalised to the picture); [changed] saves them.
+ */
+class BlueOSJellyEditorView(context: Context) : View(context), Choreographer.FrameCallback {
+    var areas: MutableList<BlueOSJelly.Area> = mutableListOf()
+        set(v) { field = v; rebuild() }
+    var selected = 0
+        set(v) { field = v; invalidate() }
+    var edit = false
+        set(v) { field = v; sim?.still(); invalidate() }
+    var accent = Color.rgb(18, 138, 250)
+    /** after an area moved / changed size or form in the editor */
+    var changed: () -> Unit = {}
+    /** a tap selected another area */
+    var onSelect: (Int) -> Unit = {}
+
+    private val dp = resources.displayMetrics.density
+    private var pic: Bitmap? = null
+    private var message: String? = null
+    private var sim: BlueOSJelly.Sim? = null
+    private val renderer by lazy { BlueOSJelly.Renderer() }
+    private val dst = Rect()
+    private val toView = Matrix()
+    private val toPic = Matrix()
+    private val picPaint = Paint(Paint.FILTER_BITMAP_FLAG)
+    private val line = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        style = Paint.Style.STROKE; strokeWidth = 2.5f * dp; pathEffect = DashPathEffect(floatArrayOf(9 * dp, 6 * dp), 0f)
+    }
+    private val fill = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val text = Paint(Paint.ANTI_ALIAS_FLAG).apply { textAlign = Paint.Align.CENTER; textSize = 18 * dp; color = Color.WHITE }
+    private val main = Handler(Looper.getMainLooper())
+
+    /** Loads the picture of [which] (FLAG_SYSTEM / FLAG_LOCK) as the wallpaper itself shows it, a copy ≤ 1080 px wide. */
+    fun load(which: Int, liveText: String) {
+        val wm = WallpaperManager.getInstance(context)
+        Thread({
+            val b = try {
+                if (wm.getWallpaperInfo(which) != null) null else wm.getBitmap(false, which)
+            } catch (e: Exception) { null }
+            val small = b?.let {
+                val k = min(1f, 1080f / it.width)
+                if (k < 1f) Bitmap.createScaledBitmap(it, (it.width * k).toInt(), (it.height * k).toInt(), true) else it
+            }
+            main.post {
+                pic = small
+                message = if (small == null) liveText else null
+                requestLayout()
+                rebuild()
+            }
+        }, "BlueOSJellyPic").start()
+    }
+
+    /** The springs and masks for the areas now (after every change). */
+    fun rebuild() {
+        val p = pic
+        if (p == null || areas.isEmpty()) { sim = null; renderer.setMasks(null); invalidate(); return }
+        renderer.setMasks(BlueOSJelly.masks(areas, p.width, p.height))
+        sim = BlueOSJelly.Sim(areas, p.width.toFloat(), p.height.toFloat())
+        invalidate()
+    }
+
+    override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
+        val w = MeasureSpec.getSize(widthMeasureSpec)
+        val p = pic
+        val screenH = resources.displayMetrics.heightPixels
+        val h = if (p == null) (w * .6f).toInt() else min((w * p.height / p.width.toFloat()).toInt(), (screenH * .62f).toInt())
+        setMeasuredDimension(w, h)
+    }
+
+    override fun onDraw(canvas: Canvas) {
+        val p = pic
+        if (p == null) {
+            message?.let {
+                text.color = Color.GRAY
+                canvas.drawText(it, width / 2f, height / 2f, text)
+            }
+            return
+        }
+        // the picture fitted into the view, centred
+        val k = min(width / p.width.toFloat(), height / p.height.toFloat())
+        val w = (p.width * k).toInt()
+        val h = (p.height * k).toInt()
+        dst.set((width - w) / 2, (height - h) / 2, (width + w) / 2, (height + h) / 2)
+        toView.setRectToRect(RectF(0f, 0f, p.width.toFloat(), p.height.toFloat()), RectF(dst), Matrix.ScaleToFit.FILL)
+        toView.invert(toPic)
+        canvas.drawBitmap(p, null, dst, picPaint)
+        val s = sim
+        if (s != null && s.moving && !edit) renderer.draw(canvas, p, dst, s)
+        if (!edit) return
+        areas.forEachIndexed { i, a ->
+            val path = BlueOSJelly.path(a, p.width.toFloat(), p.height.toFloat())
+            path.transform(toView)
+            val sel = i == selected
+            fill.color = Color.argb(36, Color.red(accent), Color.green(accent), Color.blue(accent))
+            fill.style = Paint.Style.FILL
+            canvas.drawPath(path, fill)
+            line.color = if (sel) accent else Color.argb(220, 255, 255, 255)
+            canvas.drawPath(path, line)
+            val c = mapped(BlueOSJelly.centre(a, p.width.toFloat(), p.height.toFloat()))
+            text.color = Color.WHITE
+            canvas.drawText("${i + 1}", c[0], c[1] + 6 * dp, text)
+            if (sel && a.shape != BlueOSJelly.FREE) {
+                val (hx, hy) = handle(a, SIZE)
+                knob(canvas, hx, hy, accent, Color.WHITE)
+                if (a.shape != BlueOSJelly.CIRCLE) {
+                    val (rx, ry) = handle(a, TURN)
+                    knob(canvas, rx, ry, Color.WHITE, accent)
+                }
+            }
+        }
+        if (lasso.size >= 4) {
+            val path = Path().apply {
+                moveTo(lasso[0], lasso[1]); var i = 2; while (i + 1 < lasso.size) { lineTo(lasso[i], lasso[i + 1]); i += 2 }
+            }
+            line.color = accent
+            canvas.drawPath(path, line)
+        }
+    }
+
+    private fun knob(c: Canvas, x: Float, y: Float, inner: Int, ring: Int) {
+        fill.style = Paint.Style.FILL
+        fill.color = ring
+        c.drawCircle(x, y, 13 * dp, fill)
+        fill.color = inner
+        c.drawCircle(x, y, 10 * dp, fill)
+    }
+
+    private fun mapped(xy: FloatArray): FloatArray = floatArrayOf(xy[0], xy[1]).also { toView.mapPoints(it) }
+
+    /** A handle of the area in view px: the corner ([SIZE]) or the dot above ([TURN]). */
+    private fun handle(a: BlueOSJelly.Area, which: Int): Pair<Float, Float> {
+        val p = pic ?: return 0f to 0f
+        val w = p.width.toFloat()
+        val rx = a.rx * w
+        val ry = (if (a.shape == BlueOSJelly.CIRCLE) a.rx else a.ry) * w
+        val lx: Float
+        val ly: Float
+        if (which == SIZE) { lx = rx; ly = ry } else { lx = 0f; ly = -ry - 28 * dp / scale() }
+        val c = cos(a.rot); val s = sin(a.rot)
+        val pt = floatArrayOf(a.x * w + lx * c - ly * s, a.y * p.height + lx * s + ly * c)
+        toView.mapPoints(pt)
+        return pt[0] to pt[1]
+    }
+
+    private fun scale() = toView.mapRadius(1f).coerceAtLeast(.0001f)
+
+    // ------------------------------------------------------------------ touches
+
+    private var drag = NONE
+    private var dragArea: BlueOSJelly.Area? = null
+    private var downX = 0f
+    private var downY = 0f
+    private val lasso = ArrayList<Float>()
+
+    override fun onTouchEvent(e: MotionEvent): Boolean {
+        val p = pic ?: return false
+        parent?.requestDisallowInterceptTouchEvent(true)
+        val pt = floatArrayOf(e.x, e.y).also { toPic.mapPoints(it) }
+        val px = pt[0]
+        val py = pt[1]
+        if (!edit) {
+            val s = sim ?: return true
+            when (e.actionMasked) {
+                MotionEvent.ACTION_DOWN -> if (s.down(px, py)) start()
+                MotionEvent.ACTION_MOVE -> s.move(px, py)
+                MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> { s.up(); parent?.requestDisallowInterceptTouchEvent(false) }
+            }
+            return true
+        }
+        val w = p.width.toFloat()
+        val h = p.height.toFloat()
+        when (e.actionMasked) {
+            MotionEvent.ACTION_DOWN -> {
+                downX = px; downY = py
+                drag = NONE
+                val a = areas.getOrNull(selected)
+                if (a != null && a.shape == BlueOSJelly.FREE && a.pts == null) {
+                    drag = LASSO; lasso.clear(); lasso += e.x; lasso += e.y
+                    return true
+                }
+                if (a != null && a.shape != BlueOSJelly.FREE) {
+                    val (sx, sy) = handle(a, SIZE)
+                    val (tx, ty) = handle(a, TURN)
+                    if (hypot(e.x - sx, e.y - sy) < 26 * dp) drag = SIZE
+                    else if (a.shape != BlueOSJelly.CIRCLE && hypot(e.x - tx, e.y - ty) < 26 * dp) drag = TURN
+                }
+                if (drag == NONE) {
+                    // the topmost area under the finger: select it and move it
+                    for (i in areas.indices.reversed()) {
+                        val path = BlueOSJelly.path(areas[i], w, h)
+                        val r = android.graphics.Region().apply {
+                            setPath(path, android.graphics.Region(0, 0, w.toInt(), h.toInt()))
+                        }
+                        if (r.contains(px.toInt(), py.toInt())) {
+                            if (i != selected) { selected = i; onSelect(i) }
+                            drag = MOVE
+                            break
+                        }
+                    }
+                }
+                dragArea = areas.getOrNull(selected)?.copy()
+            }
+            MotionEvent.ACTION_MOVE -> {
+                val a = areas.getOrNull(selected) ?: return true
+                val a0 = dragArea ?: return true
+                when (drag) {
+                    LASSO -> { lasso += e.x; lasso += e.y }
+                    MOVE -> {
+                        val dx = (px - downX) / w
+                        val dy = (py - downY) / h
+                        val pts = a0.pts
+                        if (pts != null) a.pts = FloatArray(pts.size) { i -> pts[i] + if (i % 2 == 0) dx else dy }
+                        else { a.x = (a0.x + dx).coerceIn(0f, 1f); a.y = (a0.y + dy).coerceIn(0f, 1f) }
+                    }
+                    SIZE -> {
+                        val ddx = px - a.x * w
+                        val ddy = py - a.y * h
+                        val c = cos(-a.rot); val s = sin(-a.rot)
+                        val lx = kotlin.math.abs(ddx * c - ddy * s)
+                        val ly = kotlin.math.abs(ddx * s + ddy * c)
+                        val minR = 24 * dp / scale()
+                        if (a.shape == BlueOSJelly.CIRCLE) a.rx = max(max(lx, ly), minR) / w
+                        else { a.rx = max(lx, minR) / w; a.ry = max(ly, minR) / w }
+                    }
+                    TURN -> a.rot = atan2(px - a.x * w, -(py - a.y * h))
+                }
+                invalidate()
+            }
+            MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> {
+                parent?.requestDisallowInterceptTouchEvent(false)
+                if (drag == LASSO) {
+                    val a = areas.getOrNull(selected)
+                    if (a != null && lasso.size >= 16) {
+                        val pts = FloatArray(lasso.size)
+                        var i = 0
+                        while (i + 1 < lasso.size) {
+                            val q = floatArrayOf(lasso[i], lasso[i + 1]).also { toPic.mapPoints(it) }
+                            pts[i] = (q[0] / w).coerceIn(0f, 1f); pts[i + 1] = (q[1] / h).coerceIn(0f, 1f)
+                            i += 2
+                        }
+                        a.pts = pts
+                    }
+                    lasso.clear()
+                }
+                if (drag != NONE) { rebuild(); changed() }
+                drag = NONE
+            }
+        }
+        return true
+    }
+
+    // ------------------------------------------------------------------ the phone's movement, frames
+
+    private var ax = 0f
+    private var ay = 0f
+    private var running = false
+    private var last = 0L
+    private val sensors = context.getSystemService(SensorManager::class.java)
+    private val accel = object : SensorEventListener {
+        override fun onSensorChanged(e: SensorEvent) {
+            var x = e.values[0]
+            var y = -e.values[1]
+            if (hypot(x, y) < BlueOSJelly.DEADZONE) { x = 0f; y = 0f }
+            ax = x; ay = y
+            if ((x != 0f || y != 0f) && !edit) start()
+        }
+        override fun onAccuracyChanged(s: Sensor?, a: Int) {}
+    }
+
+    override fun onAttachedToWindow() {
+        super.onAttachedToWindow()
+        sensors?.getDefaultSensor(Sensor.TYPE_LINEAR_ACCELERATION)?.let {
+            sensors.registerListener(accel, it, SensorManager.SENSOR_DELAY_GAME)
+        }
+    }
+
+    override fun onDetachedFromWindow() {
+        sensors?.unregisterListener(accel)
+        Choreographer.getInstance().removeFrameCallback(this)
+        running = false
+        super.onDetachedFromWindow()
+    }
+
+    private fun start() {
+        if (running) return
+        running = true
+        last = 0L
+        Choreographer.getInstance().postFrameCallback(this)
+    }
+
+    override fun doFrame(frameTimeNanos: Long) {
+        val s = sim
+        if (s == null || edit) { running = false; invalidate(); return }
+        val dt = if (last == 0L) .016f else ((frameTimeNanos - last) / 1e9f).coerceIn(.001f, .05f)
+        last = frameTimeNanos
+        val more = s.step(dt, ax, ay)
+        invalidate()
+        if (more || ax != 0f || ay != 0f) Choreographer.getInstance().postFrameCallback(this) else running = false
+    }
+
+    private companion object {
+        const val NONE = 0
+        const val MOVE = 1
+        const val SIZE = 2
+        const val TURN = 3
+        const val LASSO = 4
+    }
+}
