@@ -14,16 +14,27 @@
     <string name="blueos_s_h_chibi_life">What they do</string>
     <string name="blueos_s_chibi_walk">Walk around</string>
     <string name="blueos_s_chibi_walk_d">Now and then they walk along a widget\'s top edge or hop to another widget. Off: they stay where you put them</string>
+    <string name="blueos_s_chibi_stay">Stay on their own page</string>
+    <string name="blueos_s_chibi_stay_d">Each one lives on one home screen page and slides away with it when you swipe. Off: they stay where they are and then move to the new page\'s widgets</string>
     <string name="blueos_s_chibi_sit">Sit on a widget\'s edge</string>
     <string name="blueos_s_chibi_sit_d">Now and then a student sits down on a widget\'s top edge and swings her legs</string>
     <string name="blueos_s_chibi_depth">How low she sits</string>
-    <string name="blueos_s_chibi_depth_d">Lowered by <xliff:g id="pct" example="30">%d</xliff:g>%% of her height — the edge should be her seat</string>
+    <string name="blueos_s_chibi_depth_d">Now <xliff:g id="pct" example="30">%d</xliff:g>. At 30 she sits right on the widget\'s edge, less is a bit higher, more a bit lower</string>
     <string name="blueos_s_chibi_pat">Patting</string>
     <string name="blueos_s_chibi_pat_d">Move a finger left and right over her head: she leans her head into your hand and is happy</string>
     <string name="blueos_s_chibi_acts">Café activities</string>
-    <string name="blueos_s_chibi_acts_d">Now and then she sits down to a dessert, a keyboard or her studies — if her model has these animations</string>
+    <string name="blueos_s_chibi_acts_d">Now and then she plays her own instrument or stretches — if her model has these animations</string>
     <string name="blueos_s_chibi_touch">Touching her</string>
-    <string name="blueos_s_chibi_touch_d">A tap: she falls down and gets up again. Hold her: you pick her up, let go and she drops onto the nearest widget below. A gift from the Gifts widget: she reacts like in the café. Swipes past her still turn the pages</string>
+    <string name="blueos_s_chibi_touch_d">A tap: she falls down and gets up again. Hold her: you pick her up, let go and she drops onto the nearest widget below. Carry her to the screen\'s side to move to the next page. A gift from the Gifts widget: she reacts like in the café. Swipes past her still turn the pages</string>
+    <string name="blueos_s_h_chibi_sound">Sounds</string>
+    <string name="blueos_s_chibi_sound">Sounds</string>
+    <string name="blueos_s_chibi_sound_all">Sounds and voice</string>
+    <string name="blueos_s_chibi_sound_fx">Sounds only, no voice</string>
+    <string name="blueos_s_chibi_sound_off">Silent</string>
+    <string name="blueos_s_chibi_talk">Sometimes they talk on their own</string>
+    <string name="blueos_s_chibi_talk_d">Every few minutes one of them says something, like in the café</string>
+    <string name="blueos_s_chibi_sound_info">What you hear</string>
+    <string name="blueos_s_chibi_sound_info_d">The icons over their heads sound like in the game. Hopping, landing and picking her up have BlueOS\' own sounds. Her voice: if her lines were added in Character files. Silent while the phone is on silent or vibrate</string>
     <string name="blueos_s_h_chibi_look">Look</string>
     <string name="blueos_s_chibi_size">Size</string>
     <string name="blueos_s_chibi_size_s">Small</string>
