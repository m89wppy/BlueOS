diff --git a/res/values-ru/blueos_09_strings.xml b/res/values-ru/blueos_09_strings.xml
index b7eb2ce5..9bb1d20c 100644
--- a/res/values-ru/blueos_09_strings.xml
+++ b/res/values-ru/blueos_09_strings.xml
@@ -13,16 +13,27 @@
     <string name="blueos_s_h_chibi_life">Что они делают</string>
     <string name="blueos_s_chibi_walk">Гуляют</string>
     <string name="blueos_s_chibi_walk_d">Иногда идут по верхнему краю виджета или перепрыгивают на другой виджет. Если выключить, стоят там, куда их поставили</string>
+    <string name="blueos_s_chibi_stay">Остаются на своём экране</string>
+    <string name="blueos_s_chibi_stay_d">Каждая живёт на одном экране рабочего стола и уезжает вместе с ним, когда листаешь. Если выключить, они стоят на месте, а потом переходят на виджеты нового экрана</string>
     <string name="blueos_s_chibi_sit">Сидят на краю виджета</string>
     <string name="blueos_s_chibi_sit_d">Иногда ученица садится на верхний край виджета и болтает ногами</string>
     <string name="blueos_s_chibi_depth">Как низко садится</string>
-    <string name="blueos_s_chibi_depth_d">Опускается на <xliff:g id="pct" example="30">%d</xliff:g>%% своего роста — край виджета должен прийтись на сиденье</string>
+    <string name="blueos_s_chibi_depth_d">Сейчас <xliff:g id="pct" example="30">%d</xliff:g>. При 30 она садится ровно на край виджета, меньше — чуть выше, больше — чуть глубже</string>
     <string name="blueos_s_chibi_pat">Можно гладить</string>
     <string name="blueos_s_chibi_pat_d">Проведи пальцем по голове туда-сюда: она наклоняет голову под руку и радуется</string>
     <string name="blueos_s_chibi_acts">Занятия, как в кафе</string>
-    <string name="blueos_s_chibi_acts_d">Иногда садится за десерт, клавиатуру или учёбу — если такие анимации есть в её модели</string>
+    <string name="blueos_s_chibi_acts_d">Иногда играет на своём инструменте или потягивается — если такие анимации есть в её модели</string>
     <string name="blueos_s_chibi_touch">Касания</string>
-    <string name="blueos_s_chibi_touch_d">Нажатие — она падает и потом встаёт. Удерживай — возьмёшь в руки, отпустишь — упадёт на ближайший виджет под ней. Подарок из виджета «Подарки» — реагирует, как в кафе. Свайпы мимо неё листают экраны как обычно</string>
+    <string name="blueos_s_chibi_touch_d">Нажатие — она падает и потом встаёт. Удерживай — возьмёшь в руки, отпустишь — упадёт на ближайший виджет под ней. Поднеси её к краю экрана — перелистнётся на соседний экран. Подарок из виджета «Подарки» — реагирует, как в кафе. Свайпы мимо неё листают экраны как обычно</string>
+    <string name="blueos_s_h_chibi_sound">Звуки</string>
+    <string name="blueos_s_chibi_sound">Звуки</string>
+    <string name="blueos_s_chibi_sound_all">Звуки и голос</string>
+    <string name="blueos_s_chibi_sound_fx">Только звуки, без голоса</string>
+    <string name="blueos_s_chibi_sound_off">Без звука</string>
+    <string name="blueos_s_chibi_talk">Иногда говорят сами</string>
+    <string name="blueos_s_chibi_talk_d">Раз в несколько минут одна из них что-нибудь скажет, как в кафе</string>
+    <string name="blueos_s_chibi_sound_info">Что звучит</string>
+    <string name="blueos_s_chibi_sound_info_d">Значки над головой звучат как в игре. Прыжок, приземление и когда её берёшь — свои звуки BlueOS. Голос — если её реплики добавлены в «Файлах персонажа». Когда телефон на беззвучном или вибрации, они молчат</string>
     <string name="blueos_s_h_chibi_look">Вид</string>
     <string name="blueos_s_chibi_size">Размер</string>
     <string name="blueos_s_chibi_size_s">Маленькие</string>
diff --git a/res/values/blueos_09_strings.xml b/res/values/blueos_09_strings.xml
index 77450cd4..55a26200 100644
--- a/res/values/blueos_09_strings.xml
