diff --git a/src/com/android/wallpaper/asset/ContentUriAsset.java b/src/com/android/wallpaper/asset/ContentUriAsset.java
index 88d24fd53..3dca861dd 100755
--- a/src/com/android/wallpaper/asset/ContentUriAsset.java
+++ b/src/com/android/wallpaper/asset/ContentUriAsset.java
@@ -155,11 +155,22 @@ public final class ContentUriAsset extends StreamableAsset {
         });
     }
 
+    /** BlueOS: the ContentResolver knows no type of a file:// image (the BlueOS wallpapers): take it from the name. */
+    private String mimeType() {
+        String type = mContext.getContentResolver().getType(mUri);
+        if (type == null && "file".equals(mUri.getScheme()) && mUri.getPath() != null) {
+            String name = mUri.getPath().toLowerCase(java.util.Locale.ROOT);
+            if (name.endsWith(".jpg") || name.endsWith(".jpeg")) type = JPEG_MIME_TYPE;
+            else if (name.endsWith(".png")) type = PNG_MIME_TYPE;
+        }
+        return type;
+    }
+
     /**
      * Returns whether this image is encoded in the JPEG file format.
      */
     public boolean isJpeg() {
-        String mimeType = mContext.getContentResolver().getType(mUri);
+        String mimeType = mimeType();
         return mimeType != null && mimeType.equals(JPEG_MIME_TYPE);
     }
 
@@ -167,7 +178,7 @@ public final class ContentUriAsset extends StreamableAsset {
      * Returns whether this image is encoded in the PNG file format.
      */
     public boolean isPng() {
-        String mimeType = mContext.getContentResolver().getType(mUri);
+        String mimeType = mimeType();
         return mimeType != null && mimeType.equals(PNG_MIME_TYPE);
     }
 
