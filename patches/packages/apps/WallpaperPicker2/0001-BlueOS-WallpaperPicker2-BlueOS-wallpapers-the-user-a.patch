+package com.android.wallpaper.model;
+
+import android.content.Context;
+import android.net.Uri;
+import android.os.Parcel;
+import android.os.Parcelable;
+
+import java.io.File;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * BlueOS 0.9: a wallpaper the user added through «Настройки → Файлы персонажа» (a folder «Обои» / «Wallpapers»):
+ * Settings copies the pictures to /data/misc/blueos/wallpapers (sepolicy blueos_media_file, readable by this
+ * priv_app). Shown as the «BlueOS» category, set like a picked photo (the same crop screen).
+ */
+public class BlueOSWallpaperInfo extends ImageWallpaperInfo {
+    /** org.blueos.arona.BlueOSMedia.ADDED + "/wallpapers" */
+    public static final String DIR = "/data/misc/blueos/wallpapers";
+    public static final String COLLECTION = "blueos_wallpapers";
+
+    public static final Parcelable.Creator<BlueOSWallpaperInfo> CREATOR =
+            new Parcelable.Creator<BlueOSWallpaperInfo>() {
+                @Override
+                public BlueOSWallpaperInfo createFromParcel(Parcel in) {
+                    return new BlueOSWallpaperInfo(in);
+                }
+
+                @Override
+                public BlueOSWallpaperInfo[] newArray(int size) {
+                    return new BlueOSWallpaperInfo[size];
+                }
+            };
+
+    public BlueOSWallpaperInfo(File file) {
+        super(Uri.fromFile(file));
+    }
+
+    protected BlueOSWallpaperInfo(Parcel in) {
+        super(in);
+    }
+
+    /** Every picture in [DIR], by name. Empty when there is none (or the folder can't be read). */
+    public static List<WallpaperInfo> all() {
+        File[] files = new File(DIR).listFiles(f -> {
+            String n = f.getName().toLowerCase(Locale.ROOT);
+            return f.isFile() && !n.startsWith(".")
+                    && (n.endsWith(".jpg") || n.endsWith(".jpeg") || n.endsWith(".png") || n.endsWith(".webp"));
+        });
+        if (files == null) return Collections.emptyList();
+        Arrays.sort(files, (a, b) -> a.getName().compareToIgnoreCase(b.getName()));
+        List<WallpaperInfo> out = new ArrayList<>();
+        for (File f : files) out.add(new BlueOSWallpaperInfo(f));
+        return out;
+    }
+
+    @Override
+    public String getWallpaperId() {
+        Uri uri = getImageWallpaperUri();
+        return uri == null ? null : "blueos_" + uri.getLastPathSegment();
+    }
+
+    @Override
+    public List<String> getAttributions(Context context) {
+        return Collections.singletonList("BlueOS");
+    }
+
+    @Override
+    public String getCollectionId(Context context) {
+        return COLLECTION;
+    }
+}
