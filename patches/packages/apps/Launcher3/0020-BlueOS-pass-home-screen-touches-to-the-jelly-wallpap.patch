+package com.android.launcher3.blueos
+
+import android.app.WallpaperManager
+import android.view.MotionEvent
+import android.view.View
+import org.blueos.arona.BlueOSJelly
+
+/**
+ * BlueOS 0.9 «Желе на обоях»: a finger on the home screen's empty space goes to the wallpaper as commands (the
+ * wallpaper lives in SystemUI): down, moves (at most one per frame) and up — the area under it follows the finger.
+ * Only while the jelly is on for the home screen and some picture has areas.
+ */
+object BlueOSJellyTouch {
+    private var active = false
+    private var lastMove = 0L
+
+    @JvmStatic
+    fun forward(view: View, ev: MotionEvent) {
+        val a = ev.actionMasked
+        if (a == MotionEvent.ACTION_DOWN) {
+            active = try {
+                val c = BlueOSJelly.read(view.context.contentResolver)
+                c.on && c.home && c.pics.values.any { it.isNotEmpty() }
+            } catch (e: RuntimeException) { false }
+        }
+        if (!active) return
+        val cmd = when (a) {
+            MotionEvent.ACTION_DOWN -> BlueOSJelly.CMD_DOWN
+            MotionEvent.ACTION_MOVE -> {
+                if (ev.eventTime - lastMove < 16) return
+                lastMove = ev.eventTime
+                BlueOSJelly.CMD_MOVE
+            }
+            MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> BlueOSJelly.CMD_UP
+            else -> return
+        }
+        if (cmd == BlueOSJelly.CMD_UP) active = false
+        val token = view.windowToken ?: return
+        try {
+            WallpaperManager.getInstance(view.context)
+                .sendWallpaperCommand(token, cmd, ev.rawX.toInt(), ev.rawY.toInt(), 0, null)
+        } catch (e: RuntimeException) {
+            // the wallpaper may be gone for a moment (being changed): nothing to wiggle then
+        }
+    }
+}
