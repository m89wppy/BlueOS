+    fun speak(text: String, pos: () -> Pair<Float, Float>) {
+        val dark = (context.resources.configuration.uiMode and android.content.res.Configuration.UI_MODE_NIGHT_MASK) ==
+            android.content.res.Configuration.UI_MODE_NIGHT_YES
+        // roles of the current palette (no baked colours): a raised surface card, its text
+        bubble.color = context.getColor(if (dark) android.R.color.system_surface_container_high_dark else android.R.color.system_surface_container_high_light)
+        words.color = context.getColor(if (dark) android.R.color.system_on_surface_dark else android.R.color.system_on_surface_light)
+        val w = (min(200 * dp, words.measureText(text) + 1)).toInt().coerceAtLeast(1)
+        val layout = android.text.StaticLayout.Builder.obtain(text, 0, text.length, words, w)
+            .setMaxLines(4).setEllipsize(android.text.TextUtils.TruncateAt.END).build()
+        val now = SystemClock.uptimeMillis()
+        speech.removeAll { it.pos === pos }
+        speech += Speech(layout, now, now + (1800 + 65L * text.length).coerceAtMost(9000), pos)
+        invalidate()
+    }
+
+    private fun drawSpeech(c: Canvas, s: Speech, now: Long) {
+        val (hx, hy) = s.pos()
+        val a = min(min(1f, (now - s.at) / 180f), ((s.until - now) / 250f).coerceIn(0f, 1f))
+        if (a <= 0f) return
+        val pad = 10 * dp; val tail = 7 * dp
+        val bw = s.layout.width + 2 * pad; val bh = s.layout.height + 1.4f * pad
+        val ax = hx * dp; val ay = hy * dp                                            // the tail's tip
+        val left = (ax - bw / 2).coerceIn(8 * dp, max(8 * dp, width - bw - 8 * dp))
+        val top = ay - tail - bh
+        val al = (a * 255).toInt()
+        bubble.alpha = al
+        bubble.setShadowLayer(4 * dp, 0f, 1 * dp, Color.argb((al * .30f).toInt(), 0, 0, 0))
+        box.set(left, top, left + bw, top + bh)
+        c.drawRoundRect(box, 14 * dp, 14 * dp, bubble)
+        bubble.clearShadowLayer()
+        path.reset()
+        val tx = ax.coerceIn(left + 16 * dp, left + bw - 16 * dp)
+        path.moveTo(tx - tail, top + bh - 1); path.lineTo(tx + tail, top + bh - 1); path.lineTo(tx, top + bh + tail); path.close()
+        c.drawPath(path, bubble)
+        words.alpha = al
+        c.save(); c.translate(left + pad, top + .7f * pad); s.layout.draw(c); c.restore()
+    }
 
