+    // ---- her words: a bubble over her head while the line plays (the user, 0.9)
+    private class Speech(val layout: android.text.StaticLayout, val at: Long, val until: Long, val pos: () -> Pair<Float, Float>)
+    private val speech = ArrayList<Speech>()
+    private val words = android.text.TextPaint(Paint.ANTI_ALIAS_FLAG).apply {
