+
+/**
+ * BlueOS 0.9: «Подарки» — gifts for the chibis (BlueOSChibiLayer). A gift is dragged from here onto a student and
+ * she answers with her café reaction. 4×1, the same card as the other BlueOS widgets.
+ */
+object BlueOSGiftWidget : CustomWidget {
+    override val id: String = "blueos-gifts"
+
+    override fun updateWidgetInfo(context: Context, info: LauncherAppWidgetProviderInfo) {
+        info.label = context.getString(R.string.blueos_widget_gifts)
+        info.widgetFeatures = 0
+        info.configure = null
+        info.previewImage = 0
+        info.previewLayout = 0
+        info.resizeMode = AppWidgetProviderInfo.RESIZE_BOTH
+        info.spanX = 4; info.spanY = 1
+        info.minSpanX = 2; info.minSpanY = 1
+        info.maxSpanX = Int.MAX_VALUE; info.maxSpanY = Int.MAX_VALUE
+        info.targetCellWidth = 4; info.targetCellHeight = 1
+        info.minWidth = 1; info.minHeight = 1; info.minResizeWidth = 1; info.minResizeHeight = 1
+        info.maxResizeWidth = 0; info.maxResizeHeight = 0
+    }
+
+    override fun createView(context: Context, info: LauncherAppWidgetProviderInfo): AppWidgetHostView =
+        BlueOSGiftWidgetView(context)
+}
+
+class BlueOSGiftWidgetView(context: Context) : LauncherAppWidgetHostView(context) {
+    private val dp = resources.displayMetrics.density
+    private val card = FrameLayout(context)
+    private val title = TextView(context)
+    private val hint = TextView(context)
+    private val gifts = List(3) { GiftView(context, it) }
+
+    init {
+        val m = (8 * dp).toInt()
+        setPadding(m, m, m, m)
+        card.background = BlueOSWidgetPreview.card(context)
+        card.clipToOutline = true
+        addView(card, FrameLayout.LayoutParams(-1, -1))
+        val row = LinearLayout(context).apply {
+            orientation = LinearLayout.HORIZONTAL
+            gravity = Gravity.CENTER_VERTICAL
+            val p = (16 * dp).toInt()
+            setPadding(p, 0, (10 * dp).toInt(), 0)
+        }
+        val texts = LinearLayout(context).apply { orientation = LinearLayout.VERTICAL }
+        title.apply {
+            setText(R.string.blueos_widget_gifts)
+            setTextSize(TypedValue.COMPLEX_UNIT_SP, 17f)
+            typeface = Typeface.create("google-sans-text", Typeface.BOLD)
+            setTextColor(BlueOSColors.onSurface(context))
+            maxLines = 1
+        }
+        hint.apply {
+            setTextSize(TypedValue.COMPLEX_UNIT_SP, 13f)
+            typeface = Typeface.create("google-sans-text", Typeface.NORMAL)
+            setTextColor(BlueOSColors.onSurfaceVariant(context))
+            maxLines = 2
+        }
+        texts.addView(title); texts.addView(hint)
+        row.addView(texts, LinearLayout.LayoutParams(0, -2, 1f))
+        val size = (56 * dp).toInt()
+        for (g in gifts) row.addView(g, LinearLayout.LayoutParams(size, size).apply { marginStart = (6 * dp).toInt() })
+        card.addView(row, FrameLayout.LayoutParams(-1, -1))
+    }
+
+    override fun onAttachedToWindow() {
+        super.onAttachedToWindow()
+        // without chibis the gifts have nobody to go to: say where to add them
+        hint.setText(if (BlueOSMedia.chibis().isEmpty()) R.string.blueos_gifts_none else R.string.blueos_gifts_hint)
+    }
+
+    private fun layer() = (Launcher.getLauncher(context)?.dragLayer as? com.android.launcher3.dragndrop.DragLayer)?.blueOSChibi
+
+    /** One gift: pressed and dragged, it goes to the chibis' layer; the launcher doesn't get the gesture. */
+    private inner class GiftView(context: Context, val kind: Int) : View(context) {
+        private val paint = Paint(Paint.ANTI_ALIAS_FLAG)
+        private val path = Path()
+        private val plate = Paint(Paint.ANTI_ALIAS_FLAG)
+
+        init { contentDescription = context.getString(R.string.blueos_widget_gifts) }
+
+        override fun onDraw(c: Canvas) {
+            plate.color = BlueOSColors.primary(context); plate.alpha = 40
+            val r = 16 * dp
+            c.drawRoundRect(0f, 0f, width.toFloat(), height.toFloat(), r, r, plate)
+            BlueOSChibiFx.drawGift(c, kind, width / 2f, height / 2f, width * .72f, paint, path)
+        }
+
+        override fun onTouchEvent(e: MotionEvent): Boolean {
+            val l = layer() ?: return false
+            when (e.actionMasked) {
+                MotionEvent.ACTION_DOWN -> { parent.requestDisallowInterceptTouchEvent(true); l.giftStart(kind, e.rawX, e.rawY) }
+                MotionEvent.ACTION_MOVE -> l.giftMove(e.rawX, e.rawY)
+                MotionEvent.ACTION_UP -> l.giftEnd(e.rawX, e.rawY)
+                MotionEvent.ACTION_CANCEL -> l.giftEnd(-1e6f, -1e6f)
+            }
+            return true
+        }
+    }
+}
