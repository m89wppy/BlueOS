diff --git a/src/com/android/launcher3/blueos/BlueOSChibiFx.kt b/src/com/android/launcher3/blueos/BlueOSChibiFx.kt
new file mode 100644
index 0000000000..4a61c49a90
--- /dev/null
+++ b/src/com/android/launcher3/blueos/BlueOSChibiFx.kt
@@ -0,0 +1,163 @@
+package com.android.launcher3.blueos
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.Path
+import android.graphics.RectF
+import android.os.SystemClock
+import android.view.View
+import kotlin.math.min
+
+/**
+ * BlueOS 0.9: what is drawn over the chibis (BlueOSChibiLayer): the emotes over a head (heart, note, «!», a drop), the
+ * hand under the finger while patting, the gift being dragged from the «Подарки» widget. Our own simple drawings in dp.
+ * Never touchable; draws only while something is on it.
+ */
+class BlueOSChibiFx(context: Context) : View(context) {
+
+    private val dp = context.resources.displayMetrics.density
+    private val fill = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val line = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.STROKE; strokeJoin = Paint.Join.ROUND; strokeCap = Paint.Cap.ROUND }
+    private val path = Path()
+    private val oval = RectF()
+
+    private class Emote(val kind: Int, val at: Long, val pos: () -> Pair<Float, Float>)
+    private val emotes = ArrayList<Emote>()
+    private var handX = -1f; private var handY = -1f
+    private var ghostKind = -1; private var ghostX = 0f; private var ghostY = 0f
+
+    init {
+        importantForAccessibility = IMPORTANT_FOR_ACCESSIBILITY_NO
+        isClickable = false
+        isFocusable = false
+    }
+
+    fun emote(kind: Int, pos: () -> Pair<Float, Float>) { emotes += Emote(kind, SystemClock.uptimeMillis(), pos); invalidate() }
+    fun hand(x: Float, y: Float) { handX = x; handY = y; invalidate() }
+    fun ghost(kind: Int, x: Float, y: Float) { ghostKind = kind; ghostX = x; ghostY = y; invalidate() }
+    fun clearAll() { emotes.clear(); handX = -1f; ghostKind = -1; invalidate() }
+
+    /** Each drawn frame of the layer: emotes follow the heads. */
+    fun step(now: Long) {
+        emotes.removeAll { now - it.at > LIFE }
+        if (emotes.isNotEmpty() || handX >= 0 || ghostKind >= 0) invalidate()
+    }
+
+    override fun onDraw(c: Canvas) {
+        val now = SystemClock.uptimeMillis()
+        for (e in emotes) {
+            val (x, y) = e.pos()
+            val k = min(1f, (now - e.at) / 350f)
+            val s = (.2f + .8f * (1 - (1 - k) * (1 - k))) * 22 * dp                     // pops in
+            val a = if (now - e.at > LIFE - 300) ((LIFE - (now - e.at)) / 300f).coerceIn(0f, 1f) else 1f
+            drawEmote(c, e.kind, (x + 18) * dp, (y - 18) * dp, s, a)
+        }
+        if (handX >= 0) drawHand(c, handX * dp, (handY - 10) * dp, 24 * dp)
+        if (ghostKind >= 0) {
+            c.save(); c.translate(0f, 0f)
+            drawGift(c, ghostKind, ghostX * dp, ghostY * dp, 30 * dp, fill, path)
+            c.restore()
+        }
+    }
+
+    private fun drawEmote(c: Canvas, kind: Int, cx: Float, cy: Float, r: Float, alpha: Float) {
+        val al = (alpha * 255).toInt()
+        fill.color = Color.WHITE; fill.alpha = al
+        fill.setShadowLayer(3 * dp, 0f, 1 * dp, Color.argb((al * .35f).toInt(), 0, 0, 0))
+        c.drawCircle(cx, cy, r, fill)
+        fill.clearShadowLayer()
+        val u = r / 20f                                                                 // the mockup's 44-unit icons
+        path.reset()
+        when (kind) {
+            0 -> {                                                                      // heart
+                fill.color = 0xFFFF5C8A.toInt()
+                path.moveTo(cx, cy + 11 * u)
+                path.cubicTo(cx - 10 * u, cy + 5 * u, cx - 10 * u, cy - 7 * u, cx - 4.4f * u, cy - 7 * u)
+                path.cubicTo(cx - 2 * u, cy - 7 * u, cx, cy - 5.6f * u, cx, cy - 3.6f * u)
+                path.cubicTo(cx, cy - 5.6f * u, cx + 2 * u, cy - 7 * u, cx + 4.4f * u, cy - 7 * u)
+                path.cubicTo(cx + 10 * u, cy - 7 * u, cx + 10 * u, cy + 5 * u, cx, cy + 11 * u)
+            }
+            1 -> {                                                                      // note
+                fill.color = 0xFF128AFA.toInt()
+                c.drawCircle(cx - 5 * u, cy + 7 * u, 3.6f * u, fill.also { it.alpha = al })
+                c.drawCircle(cx + 5 * u, cy + 4.5f * u, 3.6f * u, fill)
+                path.addRect(cx - 2.4f * u, cy - 9 * u, cx - .6f * u, cy + 7 * u, Path.Direction.CW)
+                path.addRect(cx + 7.6f * u, cy - 11 * u, cx + 9.4f * u, cy + 4.5f * u, Path.Direction.CW)
+                path.moveTo(cx - 2.4f * u, cy - 9 * u); path.lineTo(cx + 9.4f * u, cy - 12 * u)
+                path.lineTo(cx + 9.4f * u, cy - 9 * u); path.lineTo(cx - 2.4f * u, cy - 6 * u); path.close()
+            }
+            2 -> {                                                                      // «!»
+                fill.color = 0xFFFF9F1C.toInt()
+                oval.set(cx - 2.5f * u, cy - 12 * u, cx + 2.5f * u, cy + 4 * u)
+                path.addRoundRect(oval, 2.5f * u, 2.5f * u, Path.Direction.CW)
+                path.addCircle(cx, cy + 10 * u, 3 * u, Path.Direction.CW)
+            }
+            else -> {                                                                   // a drop
+                fill.color = 0xFF5EC8FF.toInt()
+                path.moveTo(cx, cy - 12 * u)
+                path.cubicTo(cx + 4 * u, cy - 6 * u, cx + 7 * u, cy - 2 * u, cx + 7 * u, cy + 2 * u)
+                path.cubicTo(cx + 7 * u, cy + 6 * u, cx + 4 * u, cy + 9 * u, cx, cy + 9 * u)
+                path.cubicTo(cx - 4 * u, cy + 9 * u, cx - 7 * u, cy + 6 * u, cx - 7 * u, cy + 2 * u)
+                path.cubicTo(cx - 7 * u, cy - 2 * u, cx - 4 * u, cy - 6 * u, cx, cy - 12 * u)
+            }
+        }
+        fill.alpha = al
+        c.drawPath(path, fill)
+    }
+
+    private fun drawHand(c: Canvas, cx: Float, cy: Float, size: Float) {
+        val u = size / 24f
+        path.reset()
+        // a flat hand seen from above: palm + four fingers + thumb (rounded)
+        oval.set(cx - 9 * u, cy - 2 * u, cx + 9 * u, cy + 14 * u); path.addRoundRect(oval, 7 * u, 7 * u, Path.Direction.CW)
+        for (i in 0 until 4) {
+            val fx = cx - 7.5f * u + i * 5 * u
+            oval.set(fx - 2.2f * u, cy - 12 * u + (if (i == 0 || i == 3) 3 * u else 0f), fx + 2.2f * u, cy + 2 * u)
+            path.addRoundRect(oval, 2.2f * u, 2.2f * u, Path.Direction.CW)
+        }
+        oval.set(cx + 7 * u, cy + 1 * u, cx + 15 * u, cy + 6 * u); path.addRoundRect(oval, 2.5f * u, 2.5f * u, Path.Direction.CW)
+        fill.color = Color.WHITE; fill.alpha = 255
+        c.drawPath(path, fill)
+        line.color = 0xFF16233A.toInt(); line.strokeWidth = 1.6f * u
+        c.drawPath(path, line)
+    }
+
+    companion object {
+        private const val LIFE = 1800L
+
+        /** A gift: 0 cake, 1 flower, 2 box — the same drawing as in the widget (centre, size). */
+        @JvmStatic
+        fun drawGift(c: Canvas, kind: Int, cx: Float, cy: Float, size: Float, p: Paint, path: Path) {
+            val u = size / 48f
+            val x0 = cx - 24 * u; val y0 = cy - 24 * u
+            fun X(v: Float) = x0 + v * u
+            fun Y(v: Float) = y0 + v * u
+            p.style = Paint.Style.FILL; p.alpha = 255
+            when (kind) {
+                0 -> {
+                    p.color = 0xFFFFE1C2.toInt(); c.drawRoundRect(X(8f), Y(26f), X(40f), Y(42f), 2 * u, 2 * u, p)
+                    p.color = 0xFFFF7AA2.toInt(); c.drawRect(X(8f), Y(26f), X(40f), Y(31f), p)
+                    p.color = Color.WHITE; c.drawRoundRect(X(22f), Y(12f), X(26f), Y(24f), 2 * u, 2 * u, p)
+                    p.color = 0xFFFFC23D.toInt(); c.drawOval(X(21.5f), Y(5f), X(26.5f), Y(11.5f), p)
+                }
+                1 -> {
+                    p.color = 0xFF3DB06B.toInt(); c.drawRect(X(23f), Y(26f), X(25f), Y(43f), p)
+                    p.color = 0xFFFFB3CF.toInt()
+                    for ((dx, dy) in listOf(24f to 12f, 31.5f to 18f, 28.5f to 27f, 19.5f to 27f, 16.5f to 18f)) c.drawCircle(X(dx), Y(dy), 6 * u, p)
+                    p.color = 0xFFFFD34D.toInt(); c.drawCircle(X(24f), Y(20f), 4.5f * u, p)
+                }
+                else -> {
+                    p.color = 0xFF5EC8FF.toInt(); c.drawRoundRect(X(8f), Y(20f), X(40f), Y(42f), 3 * u, 3 * u, p)
+                    p.color = 0xFF128AFA.toInt(); c.drawRoundRect(X(6f), Y(14f), X(42f), Y(22f), 3 * u, 3 * u, p)
+                    p.color = 0xFFFFD34D.toInt(); c.drawRect(X(21f), Y(14f), X(27f), Y(42f), p)
+                    path.reset()
+                    path.moveTo(X(24f), Y(14f)); path.cubicTo(X(21f), Y(8f), X(13f), Y(7f), X(14f), Y(12f)); path.cubicTo(X(15f), Y(16f), X(24f), Y(14f), X(24f), Y(14f))
+                    path.moveTo(X(24f), Y(14f)); path.cubicTo(X(27f), Y(8f), X(35f), Y(7f), X(34f), Y(12f)); path.cubicTo(X(33f), Y(16f), X(24f), Y(14f), X(24f), Y(14f))
+                    c.drawPath(path, p)
+                }
+            }
+        }
+    }
+}
diff --git a/src/com/android/launcher3/blueos/BlueOSChibiLayer.kt b/src/com/android/launcher3/blueos/BlueOSChibiLayer.kt
