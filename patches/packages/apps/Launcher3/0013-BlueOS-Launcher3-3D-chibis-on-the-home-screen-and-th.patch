@@ -0,0 +1,715 @@
+package com.android.launcher3.blueos
+
+import android.content.Context
+import android.graphics.Rect
+import android.graphics.SurfaceTexture
+import android.opengl.Matrix
+import android.os.Handler
+import android.os.Looper
+import android.os.SystemClock
+import android.util.Log
+import android.view.Choreographer
+import android.view.MotionEvent
+import android.view.TextureView
+import android.view.View
+import android.view.ViewConfiguration
+import android.view.ViewGroup
+import android.widget.FrameLayout
+import com.android.launcher3.AbstractFloatingView
+import com.android.launcher3.Launcher
+import com.android.launcher3.LauncherState
+import com.android.launcher3.dragndrop.DragLayer
+import com.google.android.filament.Camera
+import com.google.android.filament.ColorGrading
+import com.google.android.filament.Engine
+import com.google.android.filament.EntityManager
+import com.google.android.filament.Filament
+import com.google.android.filament.LightManager
+import com.google.android.filament.Renderer
+import com.google.android.filament.Scene
+import com.google.android.filament.SwapChain
+import com.google.android.filament.ToneMapper
+import com.google.android.filament.Viewport
+import com.google.android.filament.android.UiHelper
+import com.google.android.filament.gltfio.AssetLoader
+import com.google.android.filament.gltfio.Gltfio
+import com.google.android.filament.gltfio.ResourceLoader
+import com.google.android.filament.gltfio.UbershaderProvider
+import java.io.File
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+import java.util.concurrent.Executors
+import org.blueos.arona.BlueOSMedia
+import org.blueos.arona.BlueOSSettings as K
+import org.json.JSONArray
+import org.json.JSONObject
+import kotlin.math.abs
+import kotlin.math.atan2
+import kotlin.math.cos
+import kotlin.math.hypot
+import kotlin.math.max
+import kotlin.math.min
+import kotlin.math.sign
+import kotlin.math.sin
+
+/**
+ * BlueOS 0.9: 3D chibis living on the home screen — the user's own .glb files (Settings «Файлы персонажа» copies them
+ * to /data/misc/blueos/chibi; nothing of the kind ships with BlueOS). The mockup this follows is
+ * mockups/blueos-0.9-chibi.html:
+ *  - they stand on the top edges of the current page's widgets and on the ground above the hotseat, walk along an
+ *    edge, hop to another one, sit on one with the legs over the card, do a café activity;
+ *  - a finger moving over the head pats her (our own pat: the head tilts toward the hand and dips, the body squashes
+ *    a little — models have no pat animation), a hold picks her up (Formation_Pickup), a short tap plays Vital_Death
+ *    (the user's choice), a gift dragged from the «Подарки» widget onto her plays Cafe_Reaction;
+ *  - until a gesture is hers the launcher sees it as usual; when she takes it the others get a cancel.
+ * Drawn by Filament (vendor/blueos/prebuilts/filament) into a translucent TextureView over the workspace. Light «like
+ * the game» = the materials made unlit (KHR_materials_unlit added to the glb's JSON when loading). Frames: 60 while
+ * something moves, the «Плавность в покое» setting otherwise, none when the home screen isn't showing.
+ */
+class BlueOSChibiLayer(private val launcher: Launcher, private val dragLayer: DragLayer) {
+
+    private val context: Context = launcher
+    private val cr = context.contentResolver
+    private val density = context.resources.displayMetrics.density
+    private val main = Handler(Looper.getMainLooper())
+    private val io = Executors.newSingleThreadExecutor()
+
+    private val texture = TextureView(context).apply { isOpaque = false; importantForAccessibility = View.IMPORTANT_FOR_ACCESSIBILITY_NO }
+    private val fx = BlueOSChibiFx(context)
+    private var gl: Gl? = null
+    private val chibis = ArrayList<Chibi>()
+    private var loadedSig = ""
+    private var running = false
+    private var lastFrame = 0L
+    private var lastDraw = 0L
+
+    // the edges she can stand on, in dp of the screen (updated every frame from the current page)
+    private val plats = ArrayList<Plat>()
+    private var ground = Plat(0f, 0f, 0f, true)
+    private var screenW = 411f
+    private var screenH = 914f
+
+    // settings, read when they change
+    private var on = true
+    private var walk = true
+    private var sit = true
+    private var pat = true
+    private var acts = true
+    private var sizeDp = 120f
+    private var lit = false
+    private var idleFps = 30
+    private var sitDepth = .3f
+
+    init {
+        // under everything that floats (folders, popups, drags): right after the hotseat, like the workspace's things
+        val at = dragLayer.indexOfChild(launcher.hotseat).let { if (it < 0) dragLayer.childCount else it + 1 }
+        dragLayer.addView(texture, at, FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT))
+        dragLayer.addView(fx, at + 1, FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT))
+        texture.alpha = 0f
+        readSettings()
+        K.observe(context, K.CHIBI_KEYS) { readSettings(); reload() }
+        // a new import (Settings) changes the folder: looked at again whenever the launcher comes back
+        dragLayer.viewTreeObserver.addOnWindowFocusChangeListener { if (it) reload() }
+        reload()
+    }
+
+    private fun readSettings() {
+        on = K.on(cr, K.CHIBI_ON); walk = K.on(cr, K.CHIBI_WALK); sit = K.on(cr, K.CHIBI_SIT)
+        pat = K.on(cr, K.CHIBI_PAT); acts = K.on(cr, K.CHIBI_ACTS)
+        sizeDp = K.int(cr, K.CHIBI_SIZE).coerceIn(80, 170).toFloat()
+        lit = K.int(cr, K.CHIBI_LIGHT) == 1
+        idleFps = K.int(cr, K.CHIBI_FPS).let { if (it <= 15) 15 else if (it <= 30) 30 else 60 }
+        sitDepth = K.int(cr, K.CHIBI_SIT_DEPTH).coerceIn(0, 60) / 100f
+        chibis.forEach { it.fit(sizeDp) }
+    }
+
+    // ------------------------------------------------------------------ models
+
+    /** Loads what the folder has now (only if it or the light changed); nothing at all when off or no files. */
+    private fun reload() {
+        val hidden = K.string(cr, K.CHIBI_HIDDEN, "").split(';').filter { it.isNotBlank() }.toSet()
+        val files = if (on) BlueOSMedia.chibis(hidden) else emptyList()
+        val sig = files.joinToString("|") { "${it.name}:${it.length()}:${it.lastModified()}" } + "|lit=$lit"
+        if (sig == loadedSig) return
+        loadedSig = sig
+        clear()
+        if (files.isEmpty()) { release(); return }
+        io.execute {
+            val bytes = files.mapNotNull { f ->
+                try { f.name.dropLast(4) to glbForLoading(f.readBytes(), unlit = !lit) } catch (e: Exception) { Log.w(TAG, "can't read ${f.name}", e); null }
+            }
+            main.post {
+                if (sig != loadedSig) return@post
+                val g = gl ?: Gl().also { gl = it }
+                for ((name, buf) in bytes) {
+                    g.load(buf, name)?.let { chibis += Chibi(it, chibis.size).apply { fit(sizeDp); place() } }
+                }
+                Log.i(TAG, "chibis: ${chibis.map { it.m.name }}")
+                wake()
+            }
+        }
+    }
+
+    private fun clear() {
+        chibis.forEach { gl?.unload(it.m) }
+        chibis.clear()
+        fx.clearAll()
+    }
+
+    private fun release() {
+        running = false
+        gl?.destroy(); gl = null
+        texture.alpha = 0f
+    }
+
+    // ------------------------------------------------------------------ frames
+
+    private val frame = object : Choreographer.FrameCallback {
+        override fun doFrame(nanos: Long) {
+            if (!running) return
+            val show = showing()
+            if (!show) {
+                // nothing to draw while the home screen is away: look again in a while instead of every vsync
+                texture.alpha = 0f; fx.visibility = View.INVISIBLE
+                running = false
+                main.postDelayed({ wake() }, 500)
+                return
+            }
+            Choreographer.getInstance().postFrameCallback(this)
+            val now = SystemClock.uptimeMillis()
+            val busy = press?.taken == true || gift != null || chibis.any { it.busy() }
+            if (now - lastDraw < 1000 / (if (busy) 60 else idleFps) - 2) return
+            val dt = ((now - lastFrame).coerceIn(1, 100)) / 1000f
+            lastFrame = now; lastDraw = now
+            updateEdges()
+            chibis.forEach { it.update(dt, now) }
+            gl?.draw(nanos, screenW, screenH)
+            if (texture.alpha < 1f) texture.alpha = 1f
+            fx.visibility = View.VISIBLE
+            fx.step(now)
+        }
+    }
+
+    private fun wake() {
+        if (running || chibis.isEmpty()) return
+        running = true
+        lastFrame = SystemClock.uptimeMillis()
+        Choreographer.getInstance().postFrameCallback(frame)
+    }
+
+    /** The home screen itself, nothing over it: no all apps, overview, folder, popup or drag. */
+    private fun showing(): Boolean =
+        on && launcher.isStarted && launcher.isInState(LauncherState.NORMAL) &&
+            AbstractFloatingView.getTopOpenView(launcher) == null &&
+            !launcher.dragController.isDragging && launcher.workspace.alpha > .5f && texture.isAvailable
+
+    // ------------------------------------------------------------------ edges
+
+    private val rect = Rect()
+
+    /** The current page's widgets: their top edges (the card inside the 8 dp margin) + the ground above the hotseat. */
+    private fun updateEdges() {
+        screenW = dragLayer.width / density; screenH = dragLayer.height / density
+        plats.clear()
+        val ws = launcher.workspace
+        val page = ws.getPageAt(ws.currentPage) as? com.android.launcher3.CellLayout
+        val box = page?.shortcutsAndWidgets
+        if (box != null) {
+            for (i in 0 until box.childCount) {
+                val v = box.getChildAt(i)
+                if (v !is android.appwidget.AppWidgetHostView || v.visibility != View.VISIBLE) continue
+                dragLayer.getDescendantRectRelativeToSelf(v, rect)
+                val m = 8 * density
+                plats += Plat((rect.left + m) / density, (rect.right - m) / density, (rect.top + m) / density)
+            }
+        }
+        // the ground: just above the search bar under the dock (or the hotseat's top when there is none)
+        val hs = launcher.hotseat
+        val qsb = hs.qsb
+        val top = if (qsb != null && qsb.isShown) { dragLayer.getDescendantRectRelativeToSelf(qsb, rect); rect.top }
+                  else { dragLayer.getDescendantRectRelativeToSelf(hs, rect); rect.top }
+        ground = Plat(8f, screenW - 8f, top / density - 4f, true)
+        plats += ground
+        // an edge that went away (another page, a moved widget): she falls to the first one under her
+        chibis.forEach { c -> if (c.plat !in plats && c.state !in FLYING) c.fallFrom(c.x, c.y) }
+    }
+
+    private fun landing(x: Float, y: Float): Plat =
+        plats.filter { x >= it.l + 4 && x <= it.r - 4 && it.top >= y - 6 }.minByOrNull { it.top } ?: ground
+
+    // ------------------------------------------------------------------ touch
+
+    private class Press(val c: Chibi, val x: Float, val y: Float, val t: Long, val onHead: Boolean) {
+        var taken = false
+        var patting = false
+        var held = false
+    }
+
+    private var press: Press? = null
+    private val slop = ViewConfiguration.get(context).scaledTouchSlop / density
+    private val hold = Runnable { press?.let { p -> if (!p.taken) { p.taken = true; p.held = true; p.c.pickUp(); lastEv?.let { dragLayer.cancelTouchForBlueOS(it) } } } }
+    private var lastEv: MotionEvent? = null
+
+    /** From DragLayer.dispatchTouchEvent: true = the gesture is hers (the launcher already got a cancel). */
+    fun dispatch(ev: MotionEvent): Boolean {
+        if (chibis.isEmpty() || !running && ev.actionMasked == MotionEvent.ACTION_DOWN) return false
+        val x = ev.x / density
+        val y = ev.y / density
+        lastEv?.recycle(); lastEv = MotionEvent.obtain(ev)
+        when (ev.actionMasked) {
+            MotionEvent.ACTION_DOWN -> {
+                press = null
+                if (!showing()) return false
+                val c = chibis.filter { it.hit(x, y) }.maxByOrNull { it.y } ?: return false
+                val onHead = pat && y < c.headY() + c.h * .22f && c.state !in FLYING
+                press = Press(c, x, y, SystemClock.uptimeMillis(), onHead)
+                main.postDelayed(hold, 380)       // before the launcher's own long press (widget drag)
+                return false
+            }
+            MotionEvent.ACTION_MOVE -> {
+                val p = press ?: return false
+                if (p.taken) {
+                    if (p.patting) { p.c.stroke(x); fx.hand(x, y) } else if (p.held) p.c.drag(x, y)
+                    return true
+                }
+                val moved = hypot(x - p.x, y - p.y)
+                if (p.onHead && moved > 3) {
+                    // over her head: a pat — she takes the gesture (like Arona's on the lock screen)
+                    main.removeCallbacks(hold)
+                    p.taken = true; p.patting = true
+                    dragLayer.cancelTouchForBlueOS(ev)
+                    p.c.stroke(x); fx.hand(x, y)
+                    return true
+                }
+                if (moved > max(12f, slop)) { main.removeCallbacks(hold); press = null }   // a swipe: the launcher's
+                return false
+            }
+            MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> {
+                val p = press ?: return false
+                press = null
+                main.removeCallbacks(hold)
+                val up = ev.actionMasked == MotionEvent.ACTION_UP
+                if (p.patting) { p.c.endPat(); fx.hand(-1f, -1f); return true }
+                if (p.held) { p.c.letGo(); return true }
+                if (up && SystemClock.uptimeMillis() - p.t < 380 && hypot(x - p.x, y - p.y) < 12) {
+                    // a tap on her: hers, not the widget's under her
+                    dragLayer.cancelTouchForBlueOS(ev)
+                    p.c.tapped()
+                    return true
+                }
+                return false
+            }
+        }
+        return press?.taken == true
+    }
+
+    // ------------------------------------------------------------------ gifts (BlueOSGiftWidget)
+
+    private var gift: Int? = null
+
+    fun giftStart(kind: Int, rawX: Float, rawY: Float) { gift = kind; giftMove(rawX, rawY); wake() }
+
+    fun giftMove(rawX: Float, rawY: Float) {
+        val k = gift ?: return
+        val loc = IntArray(2).also { dragLayer.getLocationOnScreen(it) }
+        fx.ghost(k, (rawX - loc[0]) / density, (rawY - loc[1]) / density)
+    }
+
+    fun giftEnd(rawX: Float, rawY: Float) {
+        gift ?: return
+        gift = null
+        val loc = IntArray(2).also { dragLayer.getLocationOnScreen(it) }
+        val x = (rawX - loc[0]) / density
+        val y = (rawY - loc[1]) / density
+        fx.ghost(-1, 0f, 0f)
+        val c = chibis.filter { it.hit(x, y) }.maxByOrNull { it.y }
+            ?: chibis.minByOrNull { hypot(it.x - x, it.y - it.h * .5f - y) }?.takeIf { hypot(it.x - x, it.y - it.h * .5f - y) < it.h * .6f }
+        c?.gifted()
+    }
+
+    // ------------------------------------------------------------------ one chibi: the mockup's behaviour
+
+    private class Plat(val l: Float, val r: Float, val top: Float, val ground: Boolean = false) {
+        override fun equals(other: Any?) = other is Plat && abs(other.l - l) < 1 && abs(other.r - r) < 1 && abs(other.top - top) < 1
+        override fun hashCode() = 0
+    }
+
+    private inner class Chibi(val m: Gl.Model, val index: Int) {
+        var x = 0f; var y = 0f
+        var plat: Plat = ground
+        var state = IDLE
+        var h = 120f; var w = 50f
+        private var until = 0L; private var start = 0L; private var sitFor = 0L
+        private var face = 0f; private var turn = 0f
+        private var tx = 0f; private var hx0 = 0f; private var hy0 = 0f; private var hx1 = 0f; private var arc = 0f; private var dur = 1f
+        private var vy = 0f
+        // animation
+        private var clip = -1; private var clipT = 0f; private var once = false
+        private var prevClip = -1; private var prevT = 0f; private var fade = 1f
+        // pat
+        private var patOn = false; private var patAmt = 0f; private var patOff = 0f; private var patOffNow = 0f; private var bob = 0f
+        private var strokes = 0; private var dir = 0f; private var lastX = 0f; private var heartAt = 0L
+
+        fun fit(size: Float) { h = size; w = m.widthPerHeight * size }
+
+        fun place() {
+            plat = (plats.filter { !it.ground }.ifEmpty { listOf(ground) }).random()
+            x = plat.l + 30 + Math.random().toFloat() * max(1f, plat.r - plat.l - 60); y = plat.top
+            idle(SystemClock.uptimeMillis(), 1000 + (Math.random() * 3000).toLong())
+        }
+
+        fun busy() = state in BUSY || patOn || patAmt > .05f || fade < 1f
+
+        fun hit(px: Float, py: Float): Boolean {
+            if (!on) return false
+            val hw = max(w, h * .45f) * .62f
+            val bottom = y + if (state == SIT) h * sitDepth else 0f
+            return px > x - hw && px < x + hw && py > bottom - h * 1.02f && py < bottom + 10
+        }
+
+        fun headY(): Float = m.headScreenY() ?: (y - h * .9f)
+
+        private fun play(c: Int, loop: Boolean) {
+            if (c < 0) return
+            if (clip >= 0 && clip != c) { prevClip = clip; prevT = clipT; fade = 0f }
+            clip = c; clipT = 0f; once = !loop
+        }
+
+        fun idle(now: Long, wait: Long = 2500 + (Math.random() * 4000).toLong()) { state = IDLE; play(m.idle, true); until = now + wait }
+        private fun margin() = max(w * .5f, 14f) + 4f
+
+        private fun next(now: Long) {
+            val r = Math.random()
+            val mg = margin()
+            if (sit && !plat.ground && r < .25) {
+                state = SIT; start = now; sitFor = 6000 + (Math.random() * 8000).toLong(); face = 0f
+                x = x.coerceIn(plat.l + mg, max(plat.l + mg, plat.r - mg)); play(m.sit.takeIf { it >= 0 } ?: m.idle, true); return
+            }
+            if (walk && r < .55) {
+                val near = plats.filter { it != plat }.map { p ->
+                    val t = (x + ((Math.random() - .5) * 120).toFloat()).coerceIn(p.l + mg, max(p.l + mg, p.r - mg))
+                    Triple(p, t, hypot(t - x, (p.top - y) * 1.3f))
+                }.sortedBy { it.third }.take(3)
+                if (near.isNotEmpty()) {
+                    val (p, t, d) = near.random()
+                    state = HOP; start = now; hx0 = x; hy0 = y; hx1 = t; plat = p
+                    arc = max(0f, hy0 - p.top) + max(30f, h * .35f); dur = 450f + d * 1.1f
+                    face = if (t == x) 0f else sign(t - x) * HALF_PI
+                    play(if (m.hop >= 0) m.hop else m.walk, m.hop < 0); return
+                }
+            }
+            if (acts && m.acts.isNotEmpty() && r < .7) {
+                state = ACT; start = now; face = 0f; play(m.acts.random(), false); return
+            }
+            if (walk) { state = WALK; tx = plat.l + mg + Math.random().toFloat() * max(0f, plat.r - plat.l - 2 * mg); play(m.walk, true); return }
+            until = now + 4000
+        }
+
+        fun fallFrom(px: Float, py: Float) { plat = landing(px, py); x = px.coerceIn(plat.l + margin(), max(plat.l + margin(), plat.r - margin())); y = py; state = DROP; vy = 0f; play(m.idle, true) }
+
+        fun pickUp() { state = HELD; face = 0f; play(if (m.pick >= 0) m.pick else m.idle, true); fx.emote(index, Fx.WOW); wake() }
+        private var dragX = 0f; private var dragY = 0f
+        fun drag(px: Float, py: Float) { dragX = px; dragY = py }
+        fun letGo() { fallFrom(x, y) }
+
+        fun tapped() {
+            if (state == HELD || state == TAP) return
+            if (m.tap < 0) { gifted(Fx.NOTE); return }
+            state = TAP; start = SystemClock.uptimeMillis(); face = 0f; play(m.tap, false); fx.emote(index, Fx.WOW); wake()
+        }
+
+        fun gifted(emo: Int = Fx.HEART) {
+            if (state == HELD) return
+            state = REACT; start = SystemClock.uptimeMillis(); face = 0f; play(if (m.react >= 0) m.react else m.idle, m.react < 0); fx.emote(index, emo); wake()
+        }
+
+        fun stroke(px: Float) {
+            val now = SystemClock.uptimeMillis()
+            if (!patOn) {
+                patOn = true; strokes = 0; dir = 0f; lastX = px
+                if (state == WALK || state == REACT || state == ACT) idle(now, Long.MAX_VALUE / 4)
+                face = 0f
+            }
+            patOff = ((px - x) / (h * .28f)).coerceIn(-1f, 1f)
+            val d = sign(px - lastX)
+            if (d != 0f && d != dir && abs(px - lastX) > 2) { dir = d; strokes++; bob = 1f }
+            lastX = px
+            if (strokes >= 2 && now - heartAt > 1100) { heartAt = now; fx.emote(index, Fx.HEART) }
+            wake()
+        }
+
+        fun endPat() {
+            if (!patOn) return
+            patOn = false; patOff = 0f
+            if (state == IDLE) until = SystemClock.uptimeMillis() + 2500
+            if (strokes >= 3 && Math.random() < .6) fx.emote(index, Fx.NOTE)
+        }
+
+        fun update(dt: Float, now: Long) {
+            when (state) {
+                HELD -> { x += (dragX - x) * min(1f, dt * 18); y += (dragY + h * .55f - y) * min(1f, dt * 18) }
+                DROP -> { vy += 2600 * dt; y += vy * dt; if (y >= plat.top) { y = plat.top; idle(now, 2500); fx.emote(index, Fx.SWEAT) } }
+                WALK -> {
+                    val dx = tx - x
+                    if (abs(dx) < 1.5f) idle(now) else { x += sign(dx) * min(abs(dx), h * .5f * dt); face = sign(dx) * HALF_PI }
+                    y = plat.top
+                }
+                HOP -> {
+                    val k = min(1f, (now - start) / dur)
+                    x = hx0 + (hx1 - hx0) * k
+                    y = hy0 + (plat.top - hy0) * k - arc * 4 * k * (1 - k)
+                    if (k >= 1) { y = plat.top; idle(now, 1500 + (Math.random() * 3000).toLong()) }
+                }
+                SIT -> if (now > start + sitFor) { idle(now); if (Math.random() < .5) fx.emote(index, Fx.NOTE) }
+                TAP -> if (now > start + m.duration(m.tap) * 1000 + 1500) { idle(now); fx.emote(index, Fx.SWEAT) }
+                REACT, ACT -> if (now > start + min(m.duration(clip) * 1000, if (state == ACT) 9000f else 6000f)) idle(now)
+                IDLE -> if (now > until && !patOn && patAmt < .05f) next(now)
+            }
+            val want = if (state == WALK || state == HOP) face else 0f
+            var d = want - turn; d = atan2(sin(d), cos(d))
+            turn += d * min(1f, dt * 8)
+            // animation time: loops wrap, a once-clip holds its last pose
+            val len = m.duration(clip).coerceAtLeast(.01f)
+            clipT += dt
+            val t = if (once) min(clipT, len) else clipT % len
+            if (fade < 1f) { fade = min(1f, fade + dt / .25f); prevT += dt }
+            // pat on top of the animation
+            patAmt += ((if (patOn) 1f else 0f) - patAmt) * min(1f, dt * (if (patOn) 8 else 4))
+            patOffNow += (patOff - patOffNow) * min(1f, dt * 10)
+            bob = max(0f, bob - dt * 3)
+            val roll = -patOffNow * .32f * patAmt
+            val pitch = (.16f + bob * .10f) * patAmt
+            val sq = bob * .05f * patAmt
+            val drop = if (state == SIT) h * sitDepth else 0f
+            m.pose(clip, t, prevClip.takeIf { fade < 1f } ?: -1, prevT % m.duration(prevClip).coerceAtLeast(.01f), fade,
+                pitch, roll, x, -(y + drop), y, TILT, turn, h, sq)
+        }
+    }
+
+    // ------------------------------------------------------------------ Filament
+
+    private inner class Gl {
