+
+        inner class Model(val asset: com.google.android.filament.gltfio.FilamentAsset, val name: String) {
+            val animator = asset.instance.animator
+            private val names = (0 until animator.animationCount).map { animator.getAnimationName(it) }
+            private fun find(vararg rx: Regex): Int { for (r in rx) { val i = names.indexOfFirst { r.matches(it) }; if (i >= 0) return i }; return -1 }
+            val idle = find(Regex("Cafe_Idle", RX.I), Regex("NonWeapon_Idle", RX.I), Regex("Idle", RX.I), Regex(".*idle.*", RX.I)).coerceAtLeast(0)
+            val walk = find(Regex("Cafe_Walk", RX.I), Regex("Walk(ing)?", RX.I), Regex(".*walk.*", RX.I), Regex("Move_Ing", RX.I)).let { if (it < 0) idle else it }
+            val react = find(Regex("Cafe_Reaction", RX.I), Regex("Wave|Yes|ThumbsUp", RX.I), Regex(".*(reaction|victory).*", RX.I))
+            val tap = find(Regex("Vital_Death", RX.I), Regex("Death", RX.I), Regex(".*(death|die).*", RX.I))
+            val pick = find(Regex("Formation_Pickup", RX.I), Regex("Jump", RX.I), Regex(".*pickup.*", RX.I))
+            val sit = find(Regex("NonWeapon_DessertTable", RX.I), Regex("NonWeapon_Study", RX.I), Regex("Sitting", RX.I), Regex(".*sit.*", RX.I))
+            val hop = find(Regex("Jump", RX.I), Regex(".*jump.*", RX.I))
+            val acts = names.indices.filter { Regex("NonWeapon_(DessertTable|Keyboard|Study)", RX.I).matches(names[it]) && it != sit }
+            fun duration(i: Int) = if (i < 0) 1f else animator.getAnimationDuration(i)
+
+            private val tm = engine.transformManager
+            private val box = asset.boundingBox
+            private val minY = box.center[1] - box.halfExtent[1]
+            private val height = (box.halfExtent[1] * 2).coerceAtLeast(.001f)
+            val widthPerHeight = box.halfExtent[0] * 2 / height
+            private val head = asset.getFirstEntityByName("Bip001 Head").let { if (it != 0) it else asset.getFirstEntityByName("Head") }
+            private val neck = asset.getFirstEntityByName("Bip001 Neck")
+            private val m = FloatArray(16)
+            private val tmp = FloatArray(16)
+            private val rot = FloatArray(16)
+            private val lastHead = FloatArray(16).also { Matrix.setIdentityM(it, 0) }
+            private val lastNeck = FloatArray(16).also { Matrix.setIdentityM(it, 0) }
+
+            /** One frame: the clip (cross-faded from the previous one), our pat on the head, her place on the screen. */
+            fun pose(clip: Int, t: Float, prev: Int, prevT: Float, fade: Float, pitch: Float, roll: Float,
+                     px: Float, py: Float, pz: Float, tilt: Float, turn: Float, sizeDp: Float, squash: Float) {
+                // a bone the clip doesn't move must not keep turning: take last frame's pat back first
+                undo(head, lastHead); undo(neck, lastNeck)
+                if (clip >= 0) animator.applyAnimation(clip, t)
+                if (prev >= 0 && fade < 1f) animator.applyCrossFade(prev, prevT, fade)
+                bend(head, pitch, roll, lastHead)
+                bend(neck, pitch * .4f, roll * .4f, lastNeck)
+                animator.updateBoneMatrices()
+                val k = sizeDp / height
+                Matrix.setIdentityM(m, 0)
+                Matrix.translateM(m, 0, px, py, pz)
+                Matrix.rotateM(m, 0, Math.toDegrees(tilt.toDouble()).toFloat(), 1f, 0f, 0f)
+                Matrix.rotateM(m, 0, Math.toDegrees(turn.toDouble()).toFloat(), 0f, 1f, 0f)
+                Matrix.scaleM(m, 0, k * (1 + squash * .5f), k * (1 - squash), k * (1 + squash * .5f))
+                Matrix.translateM(m, 0, -box.center[0], -minY, -box.center[2])
+                tm.setTransform(tm.getInstance(asset.root), m)
+            }
+
+            private fun bend(e: Int, pitch: Float, roll: Float, keep: FloatArray) {
+                if (e == 0) return
+                val i = tm.getInstance(e)
+                Matrix.setIdentityM(rot, 0)
+                Matrix.rotateM(rot, 0, Math.toDegrees(pitch.toDouble()).toFloat(), 1f, 0f, 0f)
+                Matrix.rotateM(rot, 0, Math.toDegrees(roll.toDouble()).toFloat(), 0f, 0f, 1f)
+                tm.getTransform(i, tmp)
+                Matrix.multiplyMM(m, 0, tmp, 0, rot, 0)
+                tm.setTransform(i, m)
+                System.arraycopy(rot, 0, keep, 0, 16)
+            }
+
+            private fun undo(e: Int, last: FloatArray) {
+                if (e == 0) return
+                val i = tm.getInstance(e)
+                tm.getTransform(i, tmp)
+                Matrix.transposeM(rot, 0, last, 0)                  // a rotation's inverse
+                Matrix.multiplyMM(m, 0, tmp, 0, rot, 0)
+                tm.setTransform(i, m)
+                Matrix.setIdentityM(last, 0)
+            }
+
+            /** The head's height on the screen (dp), for the emotes and the pat zone. */
+            fun headScreenY(): Float? {
+                if (head == 0) return null
+                tm.getWorldTransform(tm.getInstance(head), tmp)
+                return -tmp[13]
+            }
+
+            fun headScreenX(): Float? {
+                if (head == 0) return null
+                tm.getWorldTransform(tm.getInstance(head), tmp)
+                return tmp[12]
+            }
+        }
+
+        fun load(buf: ByteBuffer, name: String): Model? {
+            val asset = loader.createAsset(buf) ?: return null.also { Log.w(TAG, "not a glTF: $name") }
+            resources.loadResources(asset)
+            asset.releaseSourceData()
+            scene.addEntities(asset.entities)
+            return Model(asset, name)
+        }
+
+        fun unload(m: Model) {
+            scene.removeEntities(m.asset.entities)
+            loader.destroyAsset(m.asset)
+        }
+
+        fun draw(nanos: Long, wDp: Float, hDp: Float) {
+            val s = swap ?: return
+            camera.setProjection(Camera.Projection.ORTHO, 0.0, wDp.toDouble(), -hDp.toDouble(), 0.0, 1.0, 10000.0)
+            if (renderer.beginFrame(s, nanos)) {
+                renderer.render(view)
+                renderer.endFrame()
+            }
+        }
+
+        fun destroy() {
+            ui.detach()
+            swap?.let { engine.destroySwapChain(it) }
+            resources.destroy()
+            loader.destroy()
+            provider.destroyMaterials()
+            provider.destroy()
+            lights.forEach { engine.destroyEntity(it) }
+            engine.destroyCameraComponent(camEntity)
+            engine.destroyView(view)
+            engine.destroyScene(scene)
+            engine.destroyRenderer(renderer)
+            engine.destroy()
+        }
+    }
+
+    private object RX { val I = RegexOption.IGNORE_CASE }
+
+    private object Fx { const val HEART = 0; const val NOTE = 1; const val WOW = 2; const val SWEAT = 3 }
+
+    /** Forwards to the overlay with the chibi's head position. */
+    private fun BlueOSChibiFx.emote(i: Int, kind: Int) {
+        val c = chibis.getOrNull(i) ?: return
+        emote(kind) { (c.m.headScreenX() ?: c.x) to (c.headY() - c.h * .12f) }
+    }
+
+    companion object {
+        private const val TAG = "BlueOSChibi"
+        private const val IDLE = 0; private const val WALK = 1; private const val HOP = 2; private const val SIT = 3
+        private const val REACT = 4; private const val ACT = 5; private const val TAP = 6; private const val HELD = 7; private const val DROP = 8
+        private val BUSY = setOf(WALK, HOP, HELD, DROP)
+        private val FLYING = setOf(HOP, HELD, DROP)
+        private const val TILT = .30f                         // seen a little from above, like the café
+        private const val HALF_PI = (Math.PI / 2).toFloat()
+
+        init {
+            Filament.init()
+            Gltfio.init()
+        }
+
+        /**
+         * The .glb as Filament gets it: a direct buffer; with [unlit] every material gets KHR_materials_unlit (the
+         * texture's own colour, no highlights — like the game's cel look). The file itself stays as it is.
+         */
+        fun glbForLoading(bytes: ByteArray, unlit: Boolean): ByteBuffer {
+            var out = bytes
+            if (unlit) {
+                val b = ByteBuffer.wrap(bytes).order(ByteOrder.LITTLE_ENDIAN)
+                if (b.getInt(0) == 0x46546C67 && b.getInt(16) == 0x4E4F534A) {
+                    val len = b.getInt(12)
+                    val g = JSONObject(String(bytes, 20, len, Charsets.UTF_8))
+                    val used = g.optJSONArray("extensionsUsed") ?: JSONArray().also { g.put("extensionsUsed", it) }
+                    if ((0 until used.length()).none { used.optString(it) == UNLIT }) used.put(UNLIT)
+                    g.optJSONArray("materials")?.let { mats ->
+                        for (i in 0 until mats.length()) {
+                            val mt = mats.getJSONObject(i)
+                            (mt.optJSONObject("extensions") ?: JSONObject().also { mt.put("extensions", it) }).put(UNLIT, JSONObject())
+                        }
+                    }
+                    var json = g.toString().toByteArray(Charsets.UTF_8)
+                    val pad = (4 - json.size % 4) % 4
+                    if (pad > 0) json += ByteArray(pad) { ' '.code.toByte() }
+                    val rest = bytes.copyOfRange(20 + len, bytes.size)        // the BIN chunk, as it was
+                    val nb = ByteBuffer.allocate(20 + json.size + rest.size).order(ByteOrder.LITTLE_ENDIAN)
+                    nb.putInt(0x46546C67).putInt(2).putInt(20 + json.size + rest.size).putInt(json.size).putInt(0x4E4F534A)
+                    nb.put(json).put(rest)
+                    out = nb.array()
+                }
+            }
+            return ByteBuffer.allocateDirect(out.size).order(ByteOrder.nativeOrder()).put(out).flip() as ByteBuffer
+        }
+
+        private const val UNLIT = "KHR_materials_unlit"
+    }
+}
