+    private static Month loadMonth(Context context, int offset) {
+        final Month m = new Month();
+        final Locale locale = Locale.getDefault();
+        final Calendar first = Calendar.getInstance();
+        final int thisYear = first.get(Calendar.YEAR);
+        first.set(Calendar.DAY_OF_MONTH, 1);
+        first.set(Calendar.HOUR_OF_DAY, 0);
+        first.set(Calendar.MINUTE, 0);
+        first.set(Calendar.SECOND, 0);
+        first.set(Calendar.MILLISECOND, 0);
+        first.add(Calendar.MONTH, offset);
+        final int month = first.get(Calendar.MONTH);
+        // «Ноябрь», another year «Ноябрь 2027» (standalone month names, first letter up)
+        final String pattern = DateFormat.getBestDateTimePattern(locale,
+                first.get(Calendar.YEAR) == thisYear ? "LLLL" : "LLLLyyyy");
+        final String title = new SimpleDateFormat(pattern, locale).format(first.getTime());
+        m.title = title.isEmpty() ? title : title.substring(0, 1).toUpperCase(locale) + title.substring(1);
+
+        final int weekStart = Utils.getFirstDayOfWeekAsCalendar(context);   // Calendar.MONDAY …
+        final String[] names = android.icu.text.DateFormatSymbols.getInstance(locale).getWeekdays(
+                android.icu.text.DateFormatSymbols.FORMAT, android.icu.text.DateFormatSymbols.SHORT);
+        for (int c = 0; c < 7; c++) m.weekdays[c] = names[(weekStart - 1 + c) % 7 + 1];
+
+        final int lead = (first.get(Calendar.DAY_OF_WEEK) - weekStart + 7) % 7;
+        m.rows = (lead + first.getActualMaximum(Calendar.DAY_OF_MONTH) + 6) / 7;
+        final int today = julianDay(System.currentTimeMillis());
+        final Calendar d = (Calendar) first.clone();
+        d.add(Calendar.DAY_OF_MONTH, -lead);
+        final int[] julian = new int[CELLS];
+        for (int i = 0; i < CELLS; i++) {
+            m.millis[i] = d.getTimeInMillis();
+            m.day[i] = d.get(Calendar.DAY_OF_MONTH);
+            m.mine[i] = d.get(Calendar.MONTH) == month;
+            julian[i] = julianDayAt(m.millis[i] + 12 * DateUtils.HOUR_IN_MILLIS);
+            m.today[i] = julian[i] == today;
+            d.add(Calendar.DAY_OF_MONTH, 1);
+        }
+        if (!canReadCalendar(context)) return m;
+        // days with events: START_DAY..END_DAY (inclusive, all-day ones in UTC days as the provider keeps them)
+        final Uri.Builder uri = Instances.CONTENT_URI.buildUpon();
+        ContentUris.appendId(uri, m.millis[0] - DateUtils.DAY_IN_MILLIS);
+        ContentUris.appendId(uri, m.millis[CELLS - 1] + 2 * DateUtils.DAY_IN_MILLIS);
+        try (Cursor c = context.getContentResolver().query(uri.build(),
+                new String[] {Instances.START_DAY, Instances.END_DAY}, Instances.VISIBLE + "=1", null, null)) {
+            while (c != null && c.moveToNext()) {
+                final int from = Math.max(c.getInt(0), julian[0]);
+                final int to = Math.min(c.getInt(1), julian[CELLS - 1]);
+                for (int j = from; j <= to; j++) {
+                    final int i = j - julian[0];
+                    if (i >= 0 && i < CELLS && m.mine[i]) m.events[i] = true;
+                }
+            }
+        } catch (RuntimeException e) {
+            // A misbehaving provider must not break the widget: no dots
+        }
+        return m;
+    }
