diff --git a/app/src/main/res/layout/blueos_month_wide_widget.xml b/app/src/main/res/layout/blueos_month_wide_widget.xml
new file mode 100644
index 00000000..d7d76aa2
--- /dev/null
+++ b/app/src/main/res/layout/blueos_month_wide_widget.xml
@@ -0,0 +1,117 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- BlueOS 0.9 «Date and calendar», wide and 2+ rows: today's date, weather and the next events | the month
+     (generated by scripts-claude/cal_layouts.py) -->
+<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"
+    android:layout_height="match_parent"
+    android:padding="8dp">
+
+    <!-- The card keeps 8 dp inside the widget's cells, like every BlueOS widget -->
+    <FrameLayout
+        android:id="@android:id/background"
+        android:layout_width="match_parent"
+        android:layout_height="match_parent"
+        android:background="@drawable/blueos_widget_outline"
+        android:clipToOutline="true">
+
+        <ImageView
+            android:id="@+id/blueos_widget_bg"
+            android:layout_width="match_parent"
+            android:layout_height="match_parent"
+            android:contentDescription="@null"
+            android:scaleType="fitXY"
+            android:src="@drawable/blueos_widget_card" />
+
+        <LinearLayout
+            android:layout_width="match_parent"
+            android:layout_height="match_parent"
+            android:clipChildren="false"
+            android:orientation="horizontal"
+            android:padding="12dp">
+
+            <LinearLayout
+                android:id="@+id/blueos_cal_today"
+                android:layout_width="0dp"
+                android:layout_height="match_parent"
+                android:layout_weight="38"
+                android:orientation="vertical">
+                <LinearLayout
+                    android:layout_width="match_parent"
+                    android:layout_height="wrap_content"
+                    android:gravity="center_vertical"
+                    android:orientation="horizontal">
+                    <TextClock
+                        android:id="@+id/blueos_day"
+                        android:layout_width="wrap_content"
+                        android:layout_height="wrap_content"
+                        android:fontFamily="blueos-clock"
+                        android:fontVariationSettings="'wght' 600"
+                        android:includeFontPadding="false"
+                        android:singleLine="true"
+                        android:textColor="@color/blueos_widget_primary"
+                        android:textSize="40sp" />
+                    <LinearLayout
+                        android:layout_width="match_parent"
+                        android:layout_height="wrap_content"
+                        android:layout_marginStart="10dp"
+                        android:orientation="vertical">
+                        <TextClock
+                            android:id="@+id/blueos_weekday"
+                            android:layout_width="match_parent"
+                            android:layout_height="wrap_content"
+                            android:ellipsize="end"
+                            android:fontFamily="google-sans-text"
+                            android:singleLine="true"
+                            android:textColor="@color/blueos_widget_on_surface"
+                            android:textSize="13sp" />
+                        <TextClock
+                            android:id="@+id/blueos_month"
+                            android:layout_width="match_parent"
+                            android:layout_height="wrap_content"
+                            android:ellipsize="end"
+                            android:fontFamily="google-sans-text"
+                            android:singleLine="true"
+                            android:textColor="@color/blueos_widget_on_surface_variant"
+                            android:textSize="13sp" />
+                    </LinearLayout>
+                </LinearLayout>
+                <!-- weather (Обои и стиль → Погода → «В виджете Дата») -->
+                <LinearLayout
+                    android:id="@+id/blueos_weather_box"
+                    android:layout_width="wrap_content"
+                    android:layout_height="wrap_content"
+                    android:layout_marginTop="6dp"
+                    android:gravity="center_vertical"
+                    android:orientation="horizontal"
+                    android:visibility="gone">
+                    <ImageView
+                        android:id="@+id/blueos_weather_icon"
+                        android:layout_width="16dp"
+                        android:layout_height="16dp"
+                        android:layout_marginEnd="3dp"
+                        android:contentDescription="@null"
+                        android:tint="@color/blueos_widget_on_surface" />
+                    <TextView
+                        android:id="@+id/blueos_weather"
+                        android:layout_width="wrap_content"
+                        android:layout_height="wrap_content"
+                        android:fontFamily="google-sans-text"
+                        android:singleLine="true"
+                        android:textColor="@color/blueos_widget_on_surface"
+                        android:textSize="13sp" />
+                </LinearLayout>
+                <include layout="@layout/blueos_cal_events" />
+            </LinearLayout>
+
+            <Space
+                android:layout_width="14dp"
+                android:layout_height="match_parent" />
+
+            <include
+                layout="@layout/blueos_cal_grid"
+                android:layout_width="0dp"
+                android:layout_height="match_parent"
+                android:layout_weight="62" />
+        </LinearLayout>
+    </FrameLayout>
+</FrameLayout>
