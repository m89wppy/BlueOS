diff --git a/app/src/main/res/xml/blueos_calendar_widget_info.xml b/app/src/main/res/xml/blueos_calendar_widget_info.xml
new file mode 100644
index 00000000..64c7e8f6
--- /dev/null
+++ b/app/src/main/res/xml/blueos_calendar_widget_info.xml
@@ -0,0 +1,15 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- BlueOS 0.9 «Календарь на месяц»: the «Date and calendar» widget placed big from the start (4 × 2 cells) -->
+<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
+    android:description="@string/blueos_calendar_widget_description"
+    android:initialLayout="@layout/blueos_month_wide_widget"
+    android:minWidth="250dp"
+    android:minHeight="180dp"
+    android:minResizeWidth="110dp"
+    android:minResizeHeight="110dp"
+    android:previewLayout="@layout/blueos_month_wide_widget"
+    android:resizeMode="horizontal|vertical"
+    android:targetCellWidth="4"
+    android:targetCellHeight="2"
+    android:updatePeriodMillis="0"
+    android:widgetCategory="home_screen" />
