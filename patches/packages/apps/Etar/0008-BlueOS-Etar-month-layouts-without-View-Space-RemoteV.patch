+package com.android.calendar.widget;
+
+/**
+ * BlueOS 0.9 «Календарь на месяц»: the «Date and calendar» widget with an entry of its own in the widget list, placed
+ * 4 × 2 (the month) from the start — the user looked for the big calendar in the list and didn't think of stretching
+ * the date. Same layouts by size, same updates (BlueOSDateWidgetProvider updates the widgets of both).
+ */
+public class BlueOSCalendarWidgetProvider extends BlueOSDateWidgetProvider {
+}
diff --git a/app/src/main/java/com/android/calendar/widget/BlueOSDateWidgetProvider.java b/app/src/main/java/com/android/calendar/widget/BlueOSDateWidgetProvider.java
index d488916b..4309b1d8 100644
--- a/app/src/main/java/com/android/calendar/widget/BlueOSDateWidgetProvider.java
+++ b/app/src/main/java/com/android/calendar/widget/BlueOSDateWidgetProvider.java
@@ -148,10 +148,20 @@ public class BlueOSDateWidgetProvider extends AppWidgetProvider {
                 || Intent.ACTION_TIMEZONE_CHANGED.equals(action)
                 || Intent.ACTION_LOCALE_CHANGED.equals(action)) {
             final AppWidgetManager wm = AppWidgetManager.getInstance(context);
-            onUpdate(context, wm, wm.getAppWidgetIds(new ComponentName(context, getClass())));
+            onUpdate(context, wm, allIds(context, wm));
         }
     }
 
+    /** 0.9: the widgets of both entries («Дата и календарь» and «Календарь на месяц»): paging, refresh and style
+     * changes come to this class and must reach the big ones too. */
+    private static int[] allIds(Context context, AppWidgetManager wm) {
+        final int[] a = wm.getAppWidgetIds(new ComponentName(context, BlueOSDateWidgetProvider.class));
+        final int[] b = wm.getAppWidgetIds(new ComponentName(context, BlueOSCalendarWidgetProvider.class));
+        final int[] out = java.util.Arrays.copyOf(a, a.length + b.length);
+        System.arraycopy(b, 0, out, a.length, b.length);
+        return out;
+    }
+
     @Override
     public void onUpdate(Context context, AppWidgetManager wm, int[] widgetIds) {
         if (widgetIds.length == 0) {
@@ -186,6 +196,8 @@ public class BlueOSDateWidgetProvider extends AppWidgetProvider {
 
     @Override
     public void onDisabled(Context context) {
+        // the other entry's widgets still need the refresh
+        if (allIds(context, AppWidgetManager.getInstance(context)).length > 0) return;
         context.getSystemService(AlarmManager.class).cancel(refreshIntent(context));
     }
 
