+/*
+ * SPDX-FileCopyrightText: BlueOS
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.blueos
+
+import android.app.Activity
+import android.content.Intent
+import android.content.res.Configuration
+import android.graphics.Typeface
+import android.graphics.drawable.GradientDrawable
+import android.net.Uri
+import android.os.Bundle
+import android.os.Handler
+import android.os.Looper
+import android.text.format.DateUtils
+import android.util.Log
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.View
+import android.view.WindowInsets
+import android.widget.LinearLayout
+import android.widget.ProgressBar
+import android.widget.ScrollView
+import android.widget.TextView
+import com.android.settings.R
+import org.json.JSONObject
+import java.io.File
+import java.net.HttpURLConnection
+import java.net.URL
+import java.util.Locale
+
+/**
+ * BlueOS 0.9: «Благодарности» (About phone). The list is NOT in the build: it is `thanks.json` in the public repository
+ * (vendor/blueos), downloaded each time the page opens and kept in files/ for when there is no internet — adding a
+ * person needs only a push, no new build. The same file feeds THANKS.md (scripts/make-thanks.py) and the site's page.
+ *
+ * Format: {"people":[{"name":"…","kind":"donate"|"help","ru":"what they did","en":"…","link":"https://…"}],
+ *          "donate":{"url":"https://…","ru":"…","en":"…"}}  — "link", "donate" optional.
+ */
+class BlueOSThanksActivity : Activity() {
+
+    private lateinit var list: LinearLayout
+    private lateinit var status: TextView
+    private lateinit var progress: ProgressBar
+    private val main = Handler(Looper.getMainLooper())
+    private val cache by lazy { File(filesDir, "thanks.json") }
+    @Volatile private var gone = false
+
+    override fun onCreate(savedInstanceState: Bundle?) {
+        super.onCreate(savedInstanceState)
+        setTitle(R.string.blueos_thanks_title)
+        val col = LinearLayout(this).apply {
+            orientation = LinearLayout.VERTICAL
+            setPadding(dp(16), dp(8), dp(16), dp(24))
+        }
+        col.addView(text(getString(R.string.blueos_thanks_intro), 16f, primary = false).apply {
+            setPadding(dp(8), dp(8), dp(8), dp(16))
+        })
+        progress = ProgressBar(this).apply { isIndeterminate = true }
+        col.addView(progress, LinearLayout.LayoutParams(dp(32), dp(32)).apply {
+            gravity = Gravity.CENTER_HORIZONTAL; bottomMargin = dp(16)
+        })
+        list = LinearLayout(this).apply { orientation = LinearLayout.VERTICAL }
+        col.addView(list)
+        status = text("", 13f, primary = false).apply { setPadding(dp(8), dp(16), dp(8), 0) }
+        col.addView(status)
+
+        val scroll = ScrollView(this).apply { addView(col) }
+        // edge to edge: keep clear of the status bar, the action bar, the navigation bar and the sides
+        val bar = TypedValue().let { tv ->
+            if (theme.resolveAttribute(android.R.attr.actionBarSize, tv, true))
+                TypedValue.complexToDimensionPixelSize(tv.data, resources.displayMetrics) else 0
+        }
+        scroll.setOnApplyWindowInsetsListener { v, insets ->
+            val i = insets.getInsets(WindowInsets.Type.systemBars() or WindowInsets.Type.displayCutout())
+            v.setPadding(i.left, i.top + bar, i.right, i.bottom)
+            insets
+        }
+        scroll.clipToPadding = false
+        setContentView(scroll)
+
+        // the saved list right away, then the fresh one
+        val saved = read(cache)
+        if (saved != null) show(saved)
+        Thread {
+            val fresh = download()
+            main.post {
+                if (gone) return@post
+                progress.visibility = View.GONE
+                when {
+                    fresh != null -> {
+                        show(fresh)
+                        status.text = getString(R.string.blueos_thanks_updated)
+                    }
+                    saved != null -> status.text = getString(R.string.blueos_thanks_offline,
+                        DateUtils.getRelativeTimeSpanString(cache.lastModified()))
+                    else -> status.text = getString(R.string.blueos_thanks_failed)
+                }
+            }
+        }.start()
+    }
+
+    override fun onDestroy() {
+        gone = true
+        super.onDestroy()
+    }
+
+    private fun download(): JSONObject? = try {
+        val c = URL(URL_THANKS).openConnection() as HttpURLConnection
+        c.connectTimeout = 8000
+        c.readTimeout = 8000
+        c.useCaches = false
+        try {
+            if (c.responseCode != 200) null
+            else {
+                val body = c.inputStream.use { it.readBytes() }
+                val json = JSONObject(String(body))
+                json.getJSONArray("people")                       // a broken file isn't saved over a good one
+                cache.writeBytes(body)
+                json
+            }
+        } finally { c.disconnect() }
+    } catch (e: Exception) {
+        Log.w(TAG, "thanks list: ${e.javaClass.simpleName}: ${e.message}")
+        null
+    }
+
+    private fun read(f: File): JSONObject? = try {
+        if (f.exists()) JSONObject(f.readText()) else null
+    } catch (e: Exception) { null }
+
+    // ------------------------------------------------------------------ ui
+
+    private fun show(json: JSONObject) {
+        list.removeAllViews()
+        val ru = Locale.getDefault().language == "ru"
+        val people = json.optJSONArray("people")
+        val donors = ArrayList<JSONObject>()
+        val helpers = ArrayList<JSONObject>()
+        for (i in 0 until (people?.length() ?: 0)) {
+            val p = people!!.optJSONObject(i) ?: continue
+            if (p.optString("name").isBlank()) continue
+            if (p.optString("kind") == "donate") donors += p else helpers += p
+        }
+        if (donors.isEmpty() && helpers.isEmpty()) {
+            list.addView(text(getString(R.string.blueos_thanks_empty), 15f, primary = false).apply {
+                setPadding(dp(8), 0, dp(8), dp(16))
+            })
+        }
+        group(R.string.blueos_thanks_donors, donors.map { row(it, ru) })
+        group(R.string.blueos_thanks_helpers, helpers.map { row(it, ru) })
+        json.optJSONObject("donate")?.let { d ->
+            val url = d.optString("url")
+            if (url.startsWith("https://")) {
+                val sub = d.optString(if (ru) "ru" else "en").ifBlank { null }
+                group(R.string.blueos_thanks_support, listOf(row(getString(R.string.blueos_thanks_support_row), sub, url)))
+            }
+        }
+    }
+
+    private fun row(p: JSONObject, ru: Boolean): View {
+        val what = p.optString(if (ru) "ru" else "en").ifBlank { p.optString(if (ru) "en" else "ru") }.ifBlank { null }
+        return row(p.optString("name"), what, p.optString("link").takeIf { it.startsWith("https://") })
+    }
+
+    private fun row(title: String, summary: String?, link: String?): View =
+        LinearLayout(this).apply {
+            orientation = LinearLayout.VERTICAL
+            setPadding(dp(16), dp(14), dp(16), dp(14))
+            minimumHeight = dp(64)
+            gravity = Gravity.CENTER_VERTICAL
+            addView(text(title, 18f, primary = true))
+            if (summary != null) addView(text(summary, 14f, primary = false))
+            if (link != null) {
+                isClickable = true
+                isFocusable = true
+                foreground = getDrawable(TypedValue().also {
+                    theme.resolveAttribute(android.R.attr.selectableItemBackground, it, true)
+                }.resourceId)
+                setOnClickListener {
+                    try {
+                        startActivity(Intent(Intent.ACTION_VIEW, Uri.parse(link)).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK))
+                    } catch (e: Exception) { Log.w(TAG, "no app for $link") }
+                }
+            }
+        }
+
+    /** Android 17 Settings groups: a title, then rows on one card colour — 24 dp outer, 4 dp inner corners. */
+    private fun group(title: Int, rows: List<View>) {
+        if (rows.isEmpty()) return
+        list.addView(text(getString(title), 14f, primary = true).apply {
+            setTextColor(color(android.R.color.system_primary_light, android.R.color.system_primary_dark))
+            typeface = Typeface.create(typeface, Typeface.BOLD)
+            setPadding(dp(8), dp(16), dp(8), dp(8))
+        })
+        val card = color(android.R.color.system_surface_bright_light, android.R.color.system_surface_bright_dark)
+        rows.forEachIndexed { i, r ->
+            val big = dp(24).toFloat()
+            val small = dp(4).toFloat()
+            val top = if (i == 0) big else small
+            val bottom = if (i == rows.size - 1) big else small
+            r.background = GradientDrawable().apply {
+                setColor(card)
+                cornerRadii = floatArrayOf(top, top, top, top, bottom, bottom, bottom, bottom)
+            }
+            r.clipToOutline = true
+            list.addView(r, LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT,
+                LinearLayout.LayoutParams.WRAP_CONTENT).apply { if (i > 0) topMargin = dp(2) })
+        }
+    }
+
+    private fun text(s: String, sp: Float, primary: Boolean) = TextView(this).apply {
+        text = s
+        setTextSize(TypedValue.COMPLEX_UNIT_SP, sp)
+        setTextColor(if (primary) color(android.R.color.system_on_surface_light, android.R.color.system_on_surface_dark)
+            else color(android.R.color.system_on_surface_variant_light, android.R.color.system_on_surface_variant_dark))
+    }
+
+    private fun dark() =
+        (resources.configuration.uiMode and Configuration.UI_MODE_NIGHT_MASK) == Configuration.UI_MODE_NIGHT_YES
+
+    private fun color(light: Int, dark: Int) = getColor(if (dark()) dark else light)
+
+    private fun dp(v: Int) = (v * resources.displayMetrics.density).toInt()
+
+    companion object {
+        private const val TAG = "BlueOSThanks"
+        /** the public repository's list (vendor/blueos/thanks.json, branch main) */
+        const val URL_THANKS = "https://raw.githubusercontent.com/m89wppy/BlueOS/main/thanks.json"
+    }
+}
