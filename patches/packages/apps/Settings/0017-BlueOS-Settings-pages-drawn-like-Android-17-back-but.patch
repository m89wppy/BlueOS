+/**
+ * The frame of the BlueOS pages in Settings («Файлы персонажа», «Благодарности»), drawn like Android 17's own pages:
+ * a round back button and the title in one row that scroll with the content, instead of the platform action bar. The action
+ * bar's height from the theme (`actionBarSize`, 112 dp in Android 17) didn't match the bar drawn (56 dp) and left a
+ * big empty gap above the content (2026-11-13). The page is edge to edge: keep clear of the system bars and the cutout.
+ */
+object BlueOSPage {
+
+    fun frame(a: Activity, title: CharSequence, content: View): ScrollView {
+        a.actionBar?.hide()
+        val res = a.resources
+        fun dp(v: Int) = (v * res.displayMetrics.density).toInt()
+        val dark = (res.configuration.uiMode and Configuration.UI_MODE_NIGHT_MASK) == Configuration.UI_MODE_NIGHT_YES
+        fun color(light: Int, darkC: Int) = a.getColor(if (dark) darkC else light)
+        val onSurface = color(android.R.color.system_on_surface_light, android.R.color.system_on_surface_dark)
+        // dark status / navigation bar icons on the light page (the theme left them white: invisible in the light theme)
+        val lightBars = WindowInsetsController.APPEARANCE_LIGHT_STATUS_BARS or
+            WindowInsetsController.APPEARANCE_LIGHT_NAVIGATION_BARS
+        a.window.insetsController?.setSystemBarsAppearance(if (dark) 0 else lightBars, lightBars)
+
+        val back = ImageButton(a).apply {
+            val up = TypedValue()
+            if (a.theme.resolveAttribute(android.R.attr.homeAsUpIndicator, up, true) && up.resourceId != 0) {
+                setImageDrawable(a.getDrawable(up.resourceId))
+            }
+            imageTintList = ColorStateList.valueOf(onSurface)
+            background = GradientDrawable().apply {
+                shape = GradientDrawable.OVAL
+                setColor(color(android.R.color.system_surface_container_high_light,
+                    android.R.color.system_surface_container_high_dark))
+            }
+            foreground = a.getDrawable(TypedValue().also {
+                a.theme.resolveAttribute(android.R.attr.selectableItemBackgroundBorderless, it, true)
+            }.resourceId)
+            contentDescription = a.getString(R.string.blueos_page_back)
+            setOnClickListener { a.finish() }
+        }
+        val head = TextView(a).apply {
+            text = title
+            setTextSize(TypedValue.COMPLEX_UNIT_SP, 22f)
+            setTextColor(onSurface)
+            maxLines = 1
+            ellipsize = android.text.TextUtils.TruncateAt.END
+        }
+        // measured on «О телефоне» (2026-11-13): one 56 dp row, a 40 dp round button 24 dp from the edge, the title 20 dp
+        // after it
+        val bar = LinearLayout(a).apply {
+            orientation = LinearLayout.HORIZONTAL
+            gravity = Gravity.CENTER_VERTICAL
+            setPadding(dp(24), 0, dp(16), 0)
+            addView(back, LinearLayout.LayoutParams(dp(40), dp(40)))
+            addView(head, LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1f)
+                .apply { marginStart = dp(20) })
+        }
+        val page = LinearLayout(a).apply {
+            orientation = LinearLayout.VERTICAL
+            gravity = Gravity.START
+            addView(bar, LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, dp(56)))
+            addView(content)
+        }
+        return ScrollView(a).apply {
+            addView(page)
+            clipToPadding = false
+            setOnApplyWindowInsetsListener { v, insets ->
+                val i = insets.getInsets(WindowInsets.Type.systemBars() or WindowInsets.Type.displayCutout())
+                v.setPadding(i.left, i.top, i.right, i.bottom)
+                insets
+            }
+        }
+    }
+}
