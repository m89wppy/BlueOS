--- a/src/com/android/settings/blueos/BlueOSAssetsActivity.kt
+++ b/src/com/android/settings/blueos/BlueOSAssetsActivity.kt
@@ -294,7 +294,9 @@ class BlueOSAssetsActivity : Activity() {
         val scene = if (deskFound) emptyList() else sources.filter {
             norm(it.name).startsWith(SCENE) && norm(it.name).substringAfterLast('.') in setOf("atlas", "skel", "png")
         }
-        if (found.isEmpty() && scene.isEmpty()) return getString(R.string.blueos_assets_none)
+        // 0.9: 3D chibis — every .glb in any folder (the user's own models; checked after copying)
+        val chibis = sources.filter { it.name.lowercase().endsWith(".glb") }.distinctBy { chibiName(it.name) }
+        if (found.isEmpty() && scene.isEmpty() && chibis.isEmpty()) return getString(R.string.blueos_assets_none)
 
         setBusy(true, R.string.blueos_assets_copying)
         val verified = HashSet<Target>()
@@ -313,6 +315,15 @@ class BlueOSAssetsActivity : Activity() {
         for (s in scene) {
             wanted += Pair<Source, (InputStream) -> Unit>(s) { input -> write(input, File(sceneDir, norm(s.name))) }
         }
+        var chibiOk = 0
+        var chibiSkipped = 0
+        for (s in chibis) {
+            wanted += Pair<Source, (InputStream) -> Unit>(s) { input ->
+                val f = File("$ADDED/$CHIBI/${chibiName(s.name)}")
+                write(input, f)
+                if (isChibi(f)) chibiOk++ else { f.delete(); chibiSkipped++ }
+            }
+        }
         copy(wanted)
         changed = true
 
@@ -334,7 +345,38 @@ class BlueOSAssetsActivity : Activity() {
             }
         }
         sceneDir.deleteRecursively()
-        return report(targets, found.keys, verified, deskCut)
+        return report(targets, found.keys, verified, deskCut, chibiOk, chibiSkipped)
+    }
+
+    /** «Airi (Band).glb» → «Airi (Band).glb»: only characters that are safe in a file name on any side. */
+    private fun chibiName(name: String) = name.replace(Regex("[\\\\/:*?\"<>|\\p{Cntrl}]"), "_")
+
+    /**
+     * A usable chibi: binary glTF 2.0 with a skin and the café walk + idle (Cafe_Idle, Cafe_Walk). Reads only the
+     * JSON chunk at the start of the file.
+     */
+    private fun isChibi(f: File): Boolean {
+        return try { readChibi(f) } catch (e: Exception) {
+            Log.w(TAG, "not a chibi: ${f.name}", e)
+            false
+        }
+    }
+
+    private fun readChibi(f: File): Boolean {
+        f.inputStream().buffered().use { s ->
+            val head = ByteArray(20)
+            if (s.readNBytes(head, 0, 20) != 20) return false
+            val b = java.nio.ByteBuffer.wrap(head).order(java.nio.ByteOrder.LITTLE_ENDIAN)
+            if (b.getInt(0) != 0x46546C67 || b.getInt(4) != 2 || b.getInt(16) != 0x4E4F534A) return false
+            val len = b.getInt(12)
+            if (len <= 0 || len > 64 shl 20) return false
+            val json = ByteArray(len)
+            if (s.readNBytes(json, 0, len) != len) return false
+            val g = org.json.JSONObject(String(json, Charsets.UTF_8))
+            val anims = g.optJSONArray("animations") ?: return false
+            val names = (0 until anims.length()).map { anims.getJSONObject(it).optString("name") }.toSet()
+            return (g.optJSONArray("skins")?.length() ?: 0) > 0 && CHIBI_NEEDS.all { it in names }
+        }
     }
 
     /** Copies to [to] via a temporary file (readable by SystemUI and the launcher); returns its sha256. */
@@ -387,7 +429,8 @@ class BlueOSAssetsActivity : Activity() {
         return true
     }
 
-    private fun report(targets: List<Target>, found: Set<Target>, verified: Set<Target>, deskCut: Boolean): String {
