+    /** Keeps reading access to [uri] across restarts (Android's persisted grant) and lets the previous one go. */
+    private fun remember(uri: Uri, tree: Boolean) {
+        val old = prefs.getString(PREF_URI, null)?.let(Uri::parse)
+        try {
+            contentResolver.takePersistableUriPermission(uri, Intent.FLAG_GRANT_READ_URI_PERMISSION)
+        } catch (e: SecurityException) {
+            Log.w(TAG, "can't keep access to $uri", e); return
+        }
+        if (old != null && old != uri) {
+            try { contentResolver.releasePersistableUriPermission(old, Intent.FLAG_GRANT_READ_URI_PERMISSION) } catch (_: Exception) {}
+        }
+        val name = try {
+            val doc = if (tree) DocumentsContract.buildDocumentUriUsingTree(uri, DocumentsContract.getTreeDocumentId(uri)) else uri
+            contentResolver.query(doc, arrayOf(Document.COLUMN_DISPLAY_NAME), null, null, null)
+                ?.use { c -> if (c.moveToFirst()) c.getString(0) else null }
+        } catch (e: Exception) { null }
+        prefs.edit().putString(PREF_URI, uri.toString()).putBoolean(PREF_TREE, tree)
+            .putString(PREF_NAME, name ?: uri.lastPathSegment?.substringAfterLast('/') ?: "").apply()
+        showAgain()
+    }
