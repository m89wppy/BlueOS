diff --git a/src/com/android/settings/blueos/BlueOSAssetsActivity.kt b/src/com/android/settings/blueos/BlueOSAssetsActivity.kt
index d627f5cba46..39a70f49185 100644
--- a/src/com/android/settings/blueos/BlueOSAssetsActivity.kt
+++ b/src/com/android/settings/blueos/BlueOSAssetsActivity.kt
@@ -568,6 +568,16 @@ class BlueOSAssetsActivity : Activity() {
             rest.forEach { lobbyTune(p, it) }
             sc.packs += p
         }
+        // 0.9: BlueOS wallpapers — every picture in a folder named «Обои» / «Wallpaper(s)», into «Обои и стиль» →
+        // the «BlueOS» category (WallpaperPicker2 BlueOSWallpaperInfo reads $ADDED/$WALLPAPERS)
+        val walls = sources.filter { s -> s.name.substringAfterLast('.', "").lowercase() in WALLPAPER_EXT &&
+            s.path.split('/', ':').any { d -> WALLPAPER_DIRS.any { it in d } } }.distinctBy { it.name.lowercase() }
+        if (walls.isNotEmpty()) {
+            val p = Pack("${getString(R.string.blueos_assets_k_wallpapers)} · ${walls.size}",
+                File("$ADDED/$WALLPAPERS").list().orEmpty().isNotEmpty(), 1)
+            for (s in walls) p.add(s) { input -> write(input, File("$ADDED/$WALLPAPERS/${chibiName(s.name)}")) }
+            sc.packs += p
+        }
         sc.packs.sortWith(compareBy({ it.order }, { it.title.lowercase() }))
         return sc
     }
@@ -771,6 +781,8 @@ class BlueOSAssetsActivity : Activity() {
         if (lobbiesNow > 0) lines += "✓ ${getString(R.string.blueos_assets_lobby, lobbiesNow)}"
         val lobbyVoicedNow = File("$ADDED/$LOBBY/_voice").listFiles { f -> f.isDirectory }?.size ?: 0
         if (lobbyVoicedNow > 0) lines += "✓ ${getString(R.string.blueos_assets_lobby_voice, lobbyVoicedNow)}"
+        val wallsNow = File("$ADDED/$WALLPAPERS").listFiles { f -> f.isFile }?.size ?: 0
+        if (wallsNow > 0) lines += "✓ ${getString(R.string.blueos_assets_wallpapers, wallsNow)}"
         val odd = found.size - verified.size
         if (odd > 0) lines += "\n" + getString(R.string.blueos_assets_odd, odd)
         lines += "\n" + getString(R.string.blueos_assets_done)
@@ -851,6 +863,7 @@ class BlueOSAssetsActivity : Activity() {
         add(getString(R.string.blueos_assets_p_arona), "spine/arona", "spine/arona_desk", "arona")
         add(getString(R.string.blueos_assets_p_plana), "spine/plana", "plana")
         add(getString(R.string.blueos_assets_p_ui), "audio/ui")
+        add(getString(R.string.blueos_assets_k_wallpapers), WALLPAPERS)
 
         val chibiDir = File("$ADDED/$CHIBI")
         val chibiVoices = File(chibiDir, "voice").listFiles { f -> f.isDirectory }.orEmpty().associateBy { it.name }
@@ -911,6 +924,10 @@ class BlueOSAssetsActivity : Activity() {
         private val CHIBI_NEEDS = listOf("Cafe_Idle", "Cafe_Walk")
         /** org.blueos.arona.BlueOSLobbies.DIR: the 0.9 memorial lobbies under [ADDED] */
         private const val LOBBY = "lobby"
+        /** WallpaperPicker2 BlueOSWallpaperInfo.DIR: the 0.9 BlueOS wallpapers under [ADDED] */
+        private const val WALLPAPERS = "wallpapers"
+        private val WALLPAPER_EXT = setOf("jpg", "jpeg", "png", "webp")
+        private val WALLPAPER_DIRS = listOf("обои", "wallpaper")
         private val LOBBY_VOICE = Regex("""^(.+?)_MemorialLobby_\d+(_\d+)?\.(ogg|wav|mp3|m4a|opus)$""", RegexOption.IGNORE_CASE)
         /** the lobbies' music: «BGM_12_….mp3» as some lobby files name it, «Theme_12.ogg» as the game does */
         private val LOBBY_MUSIC = Regex("""^(BGM_.+|Theme[_ ]?\d+)\.(ogg|wav|mp3|m4a|opus)$""", RegexOption.IGNORE_CASE)
